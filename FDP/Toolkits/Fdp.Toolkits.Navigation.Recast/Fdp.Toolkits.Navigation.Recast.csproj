<Project Sdk="Microsoft.NET.Sdk">

  <!-- W1 (DESIGN_Terrain_World §7.2): the headless home of the DotRecast navigation code (was Hrot.Stride.Core, net8.0-windows,
       although it uses no Stride type). Kept OUT of Fdp.Toolkits so DotRecast does not ride into every project that references it. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Fdp.Toolkit.Navigation.Recast</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotRecast.Recast"       Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour"       Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour.Crowd" Version="2026.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engine\Fdp.Core\Fdp.Core.csproj" />
    <ProjectReference Include="..\..\Engine\Fdp.ModuleHost\Fdp.ModuleHost.csproj" />
    <ProjectReference Include="..\Fdp.Toolkits\Fdp.Toolkits.csproj" />
  </ItemGroup>
</Project>
