<Project Sdk="Microsoft.NET.Sdk">
  <!-- CE-4454 R-1: the per-read cross-entity check, micro-benchmark. Run the Release dll with one argument: today, off, own, other or check -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fdp.Core\Fdp.Core.csproj" />
  </ItemGroup>
</Project>
