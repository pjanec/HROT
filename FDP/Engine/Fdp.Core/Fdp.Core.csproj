<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);FDP_PARANOID_MODE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fdp.Tests" />
    <InternalsVisibleTo Include="Fdp.Core.Tests" />
    <InternalsVisibleTo Include="Fdp.ModuleHost" />
    <InternalsVisibleTo Include="Fdp.ModuleHost.Tests" />
    <InternalsVisibleTo Include="Fdp.Toolkits" />
    <InternalsVisibleTo Include="Hrot.Common.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="NLog" Version="5.2.8" />
  </ItemGroup>

</Project>
