<Project Sdk="Microsoft.NET.Sdk">
  <!-- PROOF OF CONCEPT (coordinator, 2026-11-11, DESIGN_Evaluation_Cost_And_Cadence §13.3): the kernel ticked on a WORKER thread,
       the presentation a module PULLED by the render loop on the main thread, on a LEASED published snapshot. Not production code. -->
