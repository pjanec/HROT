<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fhsm.Kernel\Fhsm.Kernel.csproj" Aliases="global,KernelLib" />
    <ProjectReference Include="..\..\src\Fhsm.Compiler\Fhsm.Compiler.csproj" />
    <!-- BP-307: there is deliberately NO source generator reference here.
         `Fhsm.SourceGen` existed (FastHSM's own BATCH-11 created src/Fhsm.SourceGen/) and was
         later removed; its successor is Fdp.Toolkits.Analyzers/HsmActionGenerator.cs, the only
         `class HsmActionGenerator` left in the repo. A ProjectReference to the vanished project
         survived here until Batch 78 — MSBuild prints "Skipping project ... because it was not
         found" and succeeds, so the suite looked generator-backed and was not.
         What the SourceGen/* tests actually exercise is Helpers/GeneratedRegistrarStub.cs, a
         hand-written stand-in — a recorded decision, see
         .dev/_DONE/blueprints-2/reports/BATCH-01-REPORT.md:70.
         Referencing the successor analyzer here would NOT restore the old behaviour: it keys
         actions on the FULLY QUALIFIED name (E6(A), Batch 72) while the stub and
         ActionDispatchTests key on the short name. See the stub's header. -->
  </ItemGroup>

</Project>
