<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- U-2: ONE file (Widgets/IconTab.cs) calls ImGuiNative.igBeginTabItem — the managed overload with flags adds a close box -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NodeEditor.Core</RootNamespace>
    <AssemblyName>NodeEditor.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Internal implementation members do not require full XML doc coverage -->
    <NoWarn>1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NodeEditor.Primitives\NodeEditor.Primitives.csproj" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>
</Project>
