<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Runtime.CompilerServices.Unsafe is built-in on net8.0; needed explicitly for netstandard2.1 -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    <!-- System.Text.Json is built-in on net8.0; needed for ContextMenuItemDto attributes on netstandard2.1 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    <!-- CycloneDDS.NET: needed for net8.0 so PipelineTarget IDL is generated for downstream DDS topics -->
    <PackageReference Include="CycloneDDS.NET" Version="0.2.3-gc40f8c1444" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
  <!-- NO other ProjectReferences — this assembly is self-contained (BCL only) -->
</Project>
