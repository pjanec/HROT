<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deterministic generator of a synthetic terrain import input set (docs/DESIGN_Terrain_Synth.md). Depends on nothing in HROT. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hrot-terrain-synth</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- the generators are the Hrot.Terrain.Synth LIBRARY (CE-4428 F-1); this is the CLI shell over it -->
    <ProjectReference Include="..\..\Engine\Hrot.Terrain.Synth\Hrot.Terrain.Synth.csproj" />
  </ItemGroup>
</Project>
