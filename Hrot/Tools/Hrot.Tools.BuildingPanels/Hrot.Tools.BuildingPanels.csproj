       (BuildingPanelIndex), for the Unreal image generator's converter (scripts/terrain-to-unreal.py).
       docs/designs/IG/DRAFT_Unreal_Image_Generator.md "Building panels for Unreal". Mirrors hrot-roadscene. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hrot-building-panels</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
  </ItemGroup>
</Project>
