<Project Sdk="Microsoft.NET.Sdk">
  <!-- ⭐ A-2 (exp/threaded-analysis, HANDOFF_Coordinator_To_Backend_Threaded_Analysis_Instruments) — an INSTRUMENT, not part of HROT.sln:
       static reachability from the simulation roots and the presentation roots; the fields each side reads and writes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hrot-reach</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
  </ItemGroup>
</Project>
