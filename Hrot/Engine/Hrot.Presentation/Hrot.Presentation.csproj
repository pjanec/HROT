<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- CE-1017 S5: the Add Entity picker's entity icons - 128 px PNGs rasterized by scripts/render-entity-icons.py from the
         hand-drawn SVG sources in Assets/EntityIcons/src; served by EntityIconLibrary under the key entity/<name>. -->
    <EmbeddedResource Include="Assets\EntityIcons\*.png" LogicalName="EntityIcons/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.IG.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.ScenarioEditor.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.Presentation.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.ClusterRunner.Integration.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.Diagnostics.Breakpoints.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.Editor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hrot.Core\Hrot.Core.csproj" />
    <ProjectReference Include="..\Hrot.Traffic\Hrot.Traffic.csproj" />   <!-- ⭐ AQ93 — the SUMO road/car layer (R-4024, V7) -->
    <ProjectReference Include="..\..\Diagnostics\Hrot.Diagnostics.Breakpoints\Hrot.Diagnostics.Breakpoints.csproj" />

    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Presentation\Fdp.Presentation.csproj" />
    <!-- CE-1017 S1: the Add Entity picker (PickerRegistry / PickerEntry) — docs/DESIGN_Add_Entity_Picker.md D3 -->
    <ProjectReference Include="..\..\..\FDP\ExtDeps\NodeEdit\src\NodeEditor.UI\NodeEditor.UI.csproj" />
    <!-- GZ057/GZ058: source generator for [GizmoProjector] attribute -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Fdp.Toolkits.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="5.2.8" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>
  <!-- ⭐ CE-1120 (docs/designs/audio/DESIGN_FPS_Audio.md AU-8): sound files named by a SoundDto are looked up in assets/audio beside
       the executable; every file here must have a row in assets/audio/LICENSES.md (CC0, or CC-BY with the attribution filled). -->
  <ItemGroup>
    <None Update="assets\audio\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
