<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hrot.Common</RootNamespace>
    <AssemblyName>Hrot.Common</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.SimHost.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.Editor.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.Network</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.IG.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.StrideMock.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.Common.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Hrot.Core provides: NodeRole, HrotNodeConfig, HrotNodeContext, all moved types -->
    <ProjectReference Include="..\Hrot.Core\Hrot.Core.csproj" />
    <!-- Hrot.Network.Orchestration provides: NodeOpSlaveTranslator, DdsIdAllocatorHelper (used by HrotNodeBuilder) -->
    <ProjectReference Include="..\..\Network\Hrot.Network.Orchestration\Hrot.Network.Orchestration.csproj" />
    <!-- Fdp.Core for EntityRepository, ModuleHost.* (used by HrotNodeBuilder) -->
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <!-- Fdp.ModuleHost for IArchitectureDiagnosticsService (used by DiagnosticsDumpClusterOpHandler) -->
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.ModuleHost\Fdp.ModuleHost.csproj" />
    <!-- Fdp.Toolkits for IEntityStateExtractionService, JsonAestheticFormatter (used by DiagnosticsDumpClusterOpHandler) -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- Roslyn source generator: emits GizmoRegistrar.g.cs for [GizmoProjector] classes. -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Fdp.Toolkits.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Fdp.Network.Cyclone for DdsIdAllocator (used by HrotNodeBuilder) -->
    <ProjectReference Include="..\..\..\FDP\Network\Fdp.Network.Cyclone\Fdp.Network.Cyclone.csproj" />
    <!-- CycloneDDS.Runtime for DdsParticipant, DdsReader, DdsWriter (used by HrotNodeBuilder) -->
    <PackageReference Include="CycloneDDS.NET" Version="0.2.3-gc40f8c1444" />
    <ProjectReference Include="..\..\..\FDP\ExtDeps\StructEdit\src\StructEdit.Core\StructEdit.Core.csproj" />
    <ProjectReference Include="..\..\..\FDP\ExtDeps\StructEdit\src\StructEdit.Json\StructEdit.Json.csproj" />

  </ItemGroup>

</Project>
