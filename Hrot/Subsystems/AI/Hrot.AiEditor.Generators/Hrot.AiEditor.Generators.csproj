<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12.0</LangVersion>
    <!-- Required for projects that host Roslyn analyzers/generators. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- PU-201/PU-202: BTree + HSM IncrementalGenerators. Design §6.2. -->
    <CycloneDdsDisableCodeGen>true</CycloneDdsDisableCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirror Hrot.Blueprints.Generators.csproj: PrivateAssets=all, ExcludeAssets=runtime -->
    <!-- Batch 55: this generator parses *.bp.json itself (GeneratedBlueprintSchemaCatalog), so it has
         to understand v2. Hrot.Blueprints.Schema is a BCL-only, multi-targeted leaf, which is exactly
         why it can be referenced from a netstandard2.0 source generator.
         ⚠ Its Analyzer asset is shipped by Hrot.AI.Behaviors, the one consumer of this generator. -->
    <ProjectReference Include="..\..\Blueprints\Hrot.Blueprints.Schema\Hrot.Blueprints.Schema.csproj"
                      PrivateAssets="all" />

    <ProjectReference Include="..\Hrot.AiEditor.Persistence\Hrot.AiEditor.Persistence.csproj"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hrot.AiEditor.Generators.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⭐⭐ CE-2027 — the ONE compile-time struct-layout algorithm, shared by link with the FDP analyzers that used to carry
         three copies of it (BehaviorParameterSizeAnalyzer, BTreeActionGenerator, HsmActionGenerator). StructSizeResolver is
         its string front door. Dependency-free (Roslyn only), like its Shared/ neighbours. -->
    <Compile Include="..\..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Shared\RoslynStructLayout.cs"
             Link="Shared\RoslynStructLayout.cs" />
    <Compile Include="..\..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Shared\KnownTypeLayouts.cs"
             Link="Shared\KnownTypeLayouts.cs" />
  </ItemGroup>

</Project>
