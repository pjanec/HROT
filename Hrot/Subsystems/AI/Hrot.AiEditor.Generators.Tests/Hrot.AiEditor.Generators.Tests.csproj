<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- PU-201/PU-202/PU-205: GeneratorDriver tests for BTree+HSM IncrementalGenerators. -->
    <CycloneDdsDisableCodeGen>true</CycloneDdsDisableCodeGen>
    <!-- S1-G proof tests use unsafe pointer reads via Unsafe.As / BrainBlackboard.BehaviorParameters. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence DTOs + JSON services + emit core (the subject under test) -->
    <ProjectReference Include="..\Hrot.AiEditor.Persistence\Hrot.AiEditor.Persistence.csproj" />
    <!-- Editor models for fixture loading (reflection → model → ToDto) -->
    <ProjectReference Include="..\Hrot.BTree.Editor\Hrot.BTree.Editor.csproj" />
    <ProjectReference Include="..\Hrot.Hsm.Editor\Hrot.Hsm.Editor.csproj" />
    <!-- Real fixture assets (SampleScout / SampleGuard) -->
    <ProjectReference Include="..\..\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <!-- Generator project referenced directly (not as analyzer) so tests can
         instantiate the generator classes and drive them via CSharpGeneratorDriver. -->
    <ProjectReference Include="..\Hrot.AiEditor.Generators\Hrot.AiEditor.Generators.csproj" />
    <!-- Roslyn in-memory compiler for PU-203 integration tests (compiles bridge C# + loads ALC). -->
    <ProjectReference Include="..\..\Blueprints\Hrot.Blueprints.Compiler\Hrot.Blueprints.Compiler.csproj" />
    <!-- FDP Toolkits: BehaviorRegistry, BrainBlackboard, AiHotReloadCoordinator, BehaviorConstants. -->
    <ProjectReference Include="..\..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
  </ItemGroup>

</Project>
