<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- PU-201/PU-202/PU-205: GeneratorDriver tests for BTree+HSM IncrementalGenerators. -->
    <CycloneDdsDisableCodeGen>true</CycloneDdsDisableCodeGen>
    <!-- S1-G proof tests use unsafe pointer reads via Unsafe.As / BrainBlackboard.BehaviorParameters. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Persistence DTOs + JSON services + emit core (the subject under test) -->
    <ProjectReference Include="..\Hrot.AiEditor.Persistence\Hrot.AiEditor.Persistence.csproj" />
    <!-- Editor models for fixture loading (reflection → model → ToDto) -->
    <ProjectReference Include="..\Hrot.BTree.Editor\Hrot.BTree.Editor.csproj" />
    <ProjectReference Include="..\Hrot.Hsm.Editor\Hrot.Hsm.Editor.csproj" />
    <!-- Real fixture assets (SampleScout / SampleGuard) -->
    <ProjectReference Include="..\..\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <!-- Generator project referenced directly (not as analyzer) so tests can
         instantiate the generator classes and drive them via CSharpGeneratorDriver. -->
    <ProjectReference Include="..\Hrot.AiEditor.Generators\Hrot.AiEditor.Generators.csproj" />
    <!-- Roslyn in-memory compiler for PU-203 integration tests (compiles bridge C# + loads ALC). -->
    <!-- ⚠⚠ CE-380 (2026-09-27) — ORDINARY REFERENCE. DO **NOT** ADD SetTargetFramework HERE.
         ⭐ There is no analyzer load context for an ordinary reference, so nearest-TFM picking the
            net8.0 flavour for this net8.0 consumer is CORRECT. Pinning it to netstandard2.0 would
            strip net8.0 APIs from this project's compile surface — a real regression to guard a
            hypothetical. (CE-380 was filed against this very line and REFUTED for that reason.)
         🔒 **IF THIS IS EVER CHANGED TO `OutputItemType="Analyzer"`**, it becomes a CE-379 site and
            needs BOTH: SetTargetFramework="TargetFramework=netstandard2.0" (this project is
            multi-targeted netstandard2.0;net8.0) AND the System.Text.Json closure shipped as
            <Analyzer Include="$(Pkg...)"/> items. ⭐ `scripts/analyzer-wiring-check.py` enforces
            both and will fail the moment the attribute is added. -->
    <ProjectReference Include="..\..\Blueprints\Hrot.Blueprints.Compiler\Hrot.Blueprints.Compiler.csproj" />
    <!-- FDP Toolkits: BehaviorRegistry, BrainBlackboard, AiHotReloadCoordinator, BehaviorConstants. -->
    <ProjectReference Include="..\..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- W5 (Batch 61): referenced as an ORDINARY LIBRARY, not OutputItemType="Analyzer".
         BehaviorParameterSizeAnalyzer inlines a copy of BehaviorConstants.MaxBehaviorParamByteSize
         because it targets netstandard2.0 and cannot reference the net8.0 runtime assembly; the
         mirror is forced, so the DRIFT is the defect. Tests are net8.0 and can see both sides. -->
    <ProjectReference Include="..\..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Fdp.Toolkits.Analyzers.csproj" />
  </ItemGroup>

</Project>
