<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hrot.IG</RootNamespace>
    <AssemblyName>Hrot.IG</AssemblyName>
  </PropertyGroup>

  <!-- Expose internals to the test project so ProcessSample can be exercised directly -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hrot.IG.Tests" />
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Integration.Tests" />
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Tests" />  </ItemGroup>

  <ItemGroup>
    <!-- Hrot-specific project references -->
    <ProjectReference Include="..\..\Engine\Hrot.Common\Hrot.Common.csproj" />
    <ProjectReference Include="..\..\Engine\Hrot.Core\Hrot.Core.csproj" />
    <ProjectReference Include="..\..\Engine\Hrot.Presentation\Hrot.Presentation.csproj" />
    <ProjectReference Include="..\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <!-- NED protocol references required for DebugPrimitivesIngressTranslator and related types. -->
    <!-- NOTE: GZ045 gizmo interaction translators are now routed through INetworkFactory. -->
    <ProjectReference Include="..\..\Network\Hrot.Network.NED\Hrot.Network.NED.csproj" />

    <!-- FDP Kernel and Toolkits -->
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Presentation\Fdp.Presentation.csproj" />
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- GZ058: source generator for [GizmoProjector] attribute on EffectPresentationGizmo. -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Fdp.Toolkits.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />  </ItemGroup>

  <ItemGroup>
    <!-- NuGet packages -->
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <PackageReference Include="NLog" Version="5.2.8" />  </ItemGroup>

</Project>
