<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AQ93 §12 N1 (R-4054) — the dedicated SUMO traffic node: mode "traffic", role NodeRole.Traffic.
    It is a SharedApplicationBootstrapper like every other ECS node; the role and the one capability
    (TrafficPack.Serving) are the only differences. See docs/blueprints/Architect_Question_93_Sumo_Traffic_Node.md §12.

    Sits above Hrot.SimHost for the same reason Hrot.NodeComposition does: NodeBootstrapper (shared
    orchestration) and HrotScenarioSerializerFactory live there.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hrot.TrafficNode</RootNamespace>
    <AssemblyName>Hrot.TrafficNode</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SharedApplicationBootstrapper, HrotNodeBuilder, EntityCreationPack -->
    <ProjectReference Include="..\..\Engine\Hrot.Common\Hrot.Common.csproj" />
    <!-- INetworkFactory, HrotNodeConfig -->
    <ProjectReference Include="..\..\Engine\Hrot.Core\Hrot.Core.csproj" />
    <!-- SubsystemDebugProvider / IProvidesDebugSurface -->
    <ProjectReference Include="..\..\Engine\Hrot.Presentation\Hrot.Presentation.csproj" />
    <!-- HrotNodeBuilder.WithReplication (the NED replication module and its shared translator pack) -->
    <ProjectReference Include="..\..\Network\Hrot.Network.NED\Hrot.Network.NED.csproj" />
    <!-- TrafficPack.Serving() -->
    <ProjectReference Include="..\..\Engine\Hrot.Traffic\Hrot.Traffic.csproj" />
    <!-- NodeBootstrapper (shared orchestration) and HrotScenarioSerializerFactory -->
    <ProjectReference Include="..\Hrot.SimHost\Hrot.SimHost.csproj" />
    <!-- ECS world and core types -->
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <!-- ClusterSlave, ScenarioSerializer, ISubsystem -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
  </ItemGroup>

</Project>
