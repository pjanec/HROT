<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- Required for projects that host Roslyn analyzers/generators. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- NOTE: The project reference to Hrot.Blueprints.Core cannot be included here
       because netstandard2.0 cannot restore a net8.0 project reference via NuGet.
       The reference is deferred to later milestones when the generator actually uses
       Core types at generation time (via SkipGetTargetFrameworkProperties or multi-targeting).
       The placeholder generator reads .bp.json content as raw text and emits diagnostics
       without requiring Core type knowledge. -->

</Project>
