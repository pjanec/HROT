<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>xUnit2029;xUnit2013;CS0649;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hrot.Blueprints.Core\Hrot.Blueprints.Core.csproj" />
    <ProjectReference Include="..\Hrot.Blueprints.Editor\Hrot.Blueprints.Editor.csproj" />
    <!-- BP-120 (Batch 25): the authoring-path compile matrix drives the REAL source generator, not
         BlueprintTestFixture.CompileAndLoad. Referenced as an ordinary library (not OutputItemType=
         Analyzer) because the test constructs BlueprintIncrementalGenerator directly and runs it
         through CSharpGeneratorDriver. -->
    <ProjectReference Include="..\Hrot.Blueprints.Generators\Hrot.Blueprints.Generators.csproj" />
    <ProjectReference Include="..\..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <!-- WHEN-M11-T4: Reference Hrot.AI.Behaviors to enable production recipe discovery in tests -->
    <ProjectReference Include="..\..\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <!-- BATCH-03: Reference Hrot.Editor.AiShared for comparison sanitizer types -->
    <ProjectReference Include="..\..\..\Editor\Hrot.Editor.AiShared\Hrot.Editor.AiShared.csproj" />
    <!-- FIX3-001: Reference Hrot.Editor so tests can exercise EditorSubsystem.RegisterWindows -->
    <ProjectReference Include="..\..\Hrot.Editor\Hrot.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serializes this suite, matching the 9 other test projects in the repo. Without it xUnit
         defaults to parallel collections, which produced ~1 varying failure per full run. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Snapshots\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Comparison\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
