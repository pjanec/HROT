<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      BP-111 (host-timing-sensitive tests) are excluded from the DEFAULT run.

      Every assertion in Benchmarks/WhenNodePerfTests.cs is a wall-clock nanosecond budget or an
      allocation count. On a shared/virtualised machine those measure the host, not the code:
      ReadEqsResultNode_Under80ns_perInvocation has been seen at 25us against an 80ns budget, plus
      Spawn_ZeroAllocation at 7696 bytes against an expected 0. Both were green on the next run. Three
      separate names were added to the known-flake list across three batches before it was clear the
      FAMILY was the problem rather than its members.

      The assertions are deliberately NOT deleted; they are meaningful on a quiet machine, and a
      deleted perf budget is a regression nobody notices. Run them explicitly with:

          dotnet test [this project] with filter: Category=HostTimingSensitive

      A command-line filter argument overrides this property, so that command works unchanged.
      NOTE: this lowers the default suite total by 7. That drop is expected, not a regression.
    -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=HostTimingSensitive</VSTestTestCaseFilter>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>xUnit2029;xUnit2013;CS0649;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hrot.Blueprints.Core\Hrot.Blueprints.Core.csproj" />
    <ProjectReference Include="..\Hrot.Blueprints.Editor\Hrot.Blueprints.Editor.csproj" />
    <!-- BP-120 (Batch 25): the authoring-path compile matrix drives the REAL source generator, not
         BlueprintTestFixture.CompileAndLoad. Referenced as an ordinary library (not OutputItemType=
         Analyzer) because the test constructs BlueprintIncrementalGenerator directly and runs it
         through CSharpGeneratorDriver. -->
    <ProjectReference Include="..\Hrot.Blueprints.Generators\Hrot.Blueprints.Generators.csproj" />
    <ProjectReference Include="..\..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <!-- WHEN-M11-T4: Reference Hrot.AI.Behaviors to enable production recipe discovery in tests -->
    <ProjectReference Include="..\..\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <!-- BATCH-03: Reference Hrot.Editor.AiShared for comparison sanitizer types -->
    <ProjectReference Include="..\..\..\Editor\Hrot.Editor.AiShared\Hrot.Editor.AiShared.csproj" />
    <!-- FIX3-001: Reference Hrot.Editor so tests can exercise EditorSubsystem.RegisterWindows -->
    <ProjectReference Include="..\..\Hrot.Editor\Hrot.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serializes this suite, matching the 9 other test projects in the repo. Without it xUnit
         defaults to parallel collections, which produced ~1 varying failure per full run. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Snapshots\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Comparison\Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
