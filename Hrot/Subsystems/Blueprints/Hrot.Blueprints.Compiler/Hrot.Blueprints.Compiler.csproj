<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Compiler is a schema/compiler library; it does not define DDS topics. -->
    <CycloneDdsDisableCodeGen>true</CycloneDdsDisableCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hrot.Blueprints.Tests" />
    <InternalsVisibleTo Include="Hrot.Blueprints.Core" />
    <InternalsVisibleTo Include="Hrot.Blueprints.Compiler.Tests" />
  </ItemGroup>

  <!-- Q31-A: the v1⇄v2 transform, extracted so `Hrot.Common` can reach it without a cycle.
       ⚠ UNCONDITIONAL, and that is the point: the netstandard2.0 target is the generator, which is
       the one production reader that must be able to Down a v2 file. -->
  <ItemGroup>
    <ProjectReference Include="..\Hrot.Blueprints.Schema\Hrot.Blueprints.Schema.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="System.Runtime.Loader" Version="4.3.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Fdp.Toolkits is net8.0-only; only reference it for the net8.0 TFM. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- Hrot.Common provides HrotDocumentTypes used by JsonEnvelope.Write in BlueprintJsonServices. -->
    <ProjectReference Include="..\..\..\Engine\Hrot.Common\Hrot.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Compiler\Roslyn\**\*.cs" />
    <Compile Remove="Compiler\Stages\Stage8_RoslynFinalize.cs" />
  </ItemGroup>

</Project>
