<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hrot.Editor.Tests" />
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Integration.Tests" />
    <!-- Expose coordinator internals to the Blueprint test harness -->
    <InternalsVisibleTo Include="Hrot.Blueprints.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Diagnostics\Hrot.Diagnostics.Breakpoints\Hrot.Diagnostics.Breakpoints.csproj" />
    <ProjectReference Include="..\Blueprints\Hrot.Blueprints.Editor\Hrot.Blueprints.Editor.csproj" />
    <ProjectReference Include="..\..\Editor\Hrot.Editor.AiShared\Hrot.Editor.AiShared.csproj" />
    <ProjectReference Include="..\..\Engine\Hrot.Presentation\Hrot.Presentation.csproj" />
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <ProjectReference Include="..\Hrot.SimHost\Hrot.SimHost.csproj" />
    <ProjectReference Include="..\Hrot.CGF\Hrot.CGF.csproj" />
    <ProjectReference Include="..\Hrot.Orchestrator\Hrot.Orchestrator.csproj" />

    <!-- EditorSubsystem uses MapLayerAssignmentSystem from Hrot.IG.Systems -->
    <ProjectReference Include="..\Hrot.IG\Hrot.IG.csproj" />
    <!-- AttributeCompilerFactory is used by EditorSubsystem to build the JSON→ECS attribute compiler -->
    <ProjectReference Include="..\..\Network\Hrot.Network.NED\Hrot.Network.NED.csproj" />
    <!-- UrbanCombatNewScenario.RegisterUrbanCombatTkbTemplates / RegisterUrbanCombatBehaviors -->
    <ProjectReference Include="..\..\..\FDP\Examples\Fdp.Examples.Scenarios\Fdp.Examples.Scenarios.csproj" />    <!-- Ensures Hrot.AI.Behaviors.dll is copied to the output directory for hot-reload.
         No types from this assembly are used statically; the C# compiler strips the
         IL reference, but MSBuild copy-local mechanics still deliver the DLL. -->
    <ProjectReference Include="..\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <ProjectReference Include="..\AI\Hrot.BTree.Editor\Hrot.BTree.Editor.csproj" />
    <ProjectReference Include="..\AI\Hrot.Hsm.Editor\Hrot.Hsm.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <PackageReference Include="NLog" Version="5.2.8" />
  </ItemGroup>
</Project>
