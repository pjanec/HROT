<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- BTREE0002 = "BTree asset skipped (codegen validation)" — an editor-owned asset that is
         mid-edit/invalid (e.g. an unbound Action/Condition) must NOT break the assembly build;
         it is skipped + surfaced as a warning so the editor still launches (JSON-DD §1). Keep TWAE
         for everything else. Mirror for BTREE HSM equivalent if/when added. -->
    <!-- BP-121: the blueprint generator used to report diagnostics ONLY when a compile failed, so on a
         successful compile every warning it produced was silently discarded — a designer got no
         warnings from a real build, ever. The drain is now unconditional, which makes these visible.
         They must stay WARNINGS rather than build errors: an unwired pin or an orphan node is a normal
         intermediate authoring state (Unreal simply ignores an orphan), and 34 already exist in the
         shipped assets under Assets/Blueprints/, which had never been warning-checked.
         ⭐ This is the right lever: the warnings remain VISIBLE in build output — the whole point of
         BP-121 — while TreatWarningsAsErrors keeps protecting against C# warnings, which is why it is
         set. ⚠ Do NOT instead lower these to Info severity: that hides them in normal builds and
         re-creates the swallowing bug one level down. -->
    <WarningsNotAsErrors>BTREE0002;BP1657;BP3010;BP3011;BP4001;BP4004</WarningsNotAsErrors>
    <OutputType>Library</OutputType>
    <!-- Editor punch-list #4: emit the companion XML doc file next to the DLL so the
         Blueprint editor can surface curated-helper <summary> prose in function-node
         tooltips (loaded from disk at runtime; unaffected by in-memory hot reload).
         CS1591 (missing XML comment on a public member) is suppressed so the existing
         TreatWarningsAsErrors=true build stays green without back-filling docs everywhere. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Docs are ON but their quality is NOT enforced: suppress the whole doc-comment warning
         family so TreatWarningsAsErrors stays green without back-filling/repairing comments across
         the assembly (incl. the untouchable HillAttack* oracle files). Roslyn still emits a
         well-formed .xml, substituting a placeholder for any malformed/unresolved member.
         1591 missing · 1570 malformed · 1571 dup-param · 1572 param-no-match · 1573 missing-param
         · 1574/1584 cref · 1587 misplaced · 1734/1735 paramref/typeparamref. -->
    <NoWarn>$(NoWarn);1591;1570;1571;1572;1573;1574;1584;1587;1734;1735</NoWarn>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Hrot.AI.Behaviors</AssemblyName>
    <RootNamespace>Hrot.AI.Behaviors</RootNamespace>
    <!-- Blueprint generator output: emit .g.cs files to disk for debugger source resolution. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <!-- Portable PDB enables step-through debugging of generated Blueprint code. -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Hrot.IG.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Lightweight layout-contract types: BTreeEditorLayout, HsmEditorLayout, [BTree/HsmLayout] attributes, etc.
         Required so that emitted [BTreeLayout]/[HsmLayout] methods compile in this game-side assembly. -->
    <ProjectReference Include="..\..\Editor\Hrot.Editor.AiContracts\Hrot.Editor.AiContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FDP toolkit: BrainBlackboard, BTreeContext, LocomotionChannel, WeaponChannel,
         BehaviorState, NavigationConstants, MoveToParams, TargetMemory, WeaponState,
         CarKinem types, and all other Fdp.Toolkit.* namespaces used by CgfNodes.cs. -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- Roslyn source generators: GizmoRegistrar.g.cs, FbtActionRegistrar.g.cs, FbtTreeCatalog.g.cs, HsmActionRegistrar.g.cs. -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits.Analyzers\Fdp.Toolkits.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Fdp.Core: Entity type used in Condition_TargetAliveAndVisible and Action_FireAtTarget. -->
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <!-- Hrot.Core provides: TkbEntityTypes constants used by mapper implementations. -->
    <ProjectReference Include="..\..\Engine\Hrot.Core\Hrot.Core.csproj" />
    <!-- FastBTree fluent builder (BTreeBuilder<TBlackboard, TContext>) for [BTreeDefinition] methods. -->
    <ProjectReference Include="..\..\..\FDP\ExtDeps\FastBTree\src\Fbt.Compiler\Fbt.Compiler.csproj" />

    <!-- FastHSM runtime (HsmDefinitionBlob, HsmActionDispatcher, HotReloadManager, etc.). -->
    <ProjectReference Include="..\..\..\FDP\ExtDeps\FastHSM\src\Fhsm.Kernel\Fhsm.Kernel.csproj" />
    <!-- FastHSM fluent builder (HsmBuilder, HsmCompiler). -->
    <ProjectReference Include="..\..\..\FDP\ExtDeps\FastHSM\src\Fhsm.Compiler\Fhsm.Compiler.csproj" />

    <!-- Blueprint source generator: emits C# from *.bp.json AdditionalFiles. -->
    <ProjectReference Include="..\Blueprints\Hrot.Blueprints.Generators\Hrot.Blueprints.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Blueprint generator dependency assembly (netstandard2.0, VS-safe analyzer load). -->
    <ProjectReference Include="..\Blueprints\Hrot.Blueprints.Compiler\Hrot.Blueprints.Compiler.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

    <!-- Q31-A / Batch 55: the extracted v1⇄v2 transform.
         ⛔ A ProjectReference from .Compiler is NOT enough. The generator runs inside Roslyn's
         analyzer load context, which resolves only what is shipped as an Analyzer item — so a new
         dependency of .Compiler has to be listed HERE too, beside it, or every asset fails BP0002
         with "Could not load file or assembly". ⭐ Measured that way on first build; it fails loudly,
         which is the one mercy in this class of defect. -->
    <ProjectReference Include="..\Blueprints\Hrot.Blueprints.Schema\Hrot.Blueprints.Schema.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- BTree/HSM JSON source generator: emits C# from *.btree.json/*.hsm.json AdditionalFiles.
         PU-204 (§9, §2.7): wired exactly as Hrot.Blueprints.Generators above.
         No .btree.json/.hsm.json files exist yet → glob matches zero → dormant-but-correct. -->
    <ProjectReference Include="..\AI\Hrot.AiEditor.Generators\Hrot.AiEditor.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- AiEditor generator dependency assembly (netstandard2.0 emit core + JSON services). -->
    <ProjectReference Include="..\AI\Hrot.AiEditor.Persistence\Hrot.AiEditor.Persistence.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Blueprint asset files (final): picked up by the incremental generator.
       Recipes moved to Recipes/Blueprints/ — no longer under the Assets tree,
       so no Exclude needed. -->
  <ItemGroup>
    <AdditionalFiles Include="Assets\Blueprints\**\*.bp.json" />
    <!-- Ensure .bp.json changes invalidate the incremental build up-to-date check
         so the source generator re-runs and regenerates .g.cs files. -->
    <UpToDateCheckInput Include="Assets\Blueprints\**\*.bp.json" />
  </ItemGroup>

  <!-- BTree/HSM JSON asset files: picked up by BTreeJsonGenerator/HsmJsonGenerator.
       PU-204 (§9): dormant until PU-401 migration produces more files. -->
  <ItemGroup>
    <AdditionalFiles Include="Assets\BTrees\**\*.btree.json" />
    <AdditionalFiles Include="Assets\HSMs\**\*.hsm.json" />
  </ItemGroup>

  <!-- Recipe blueprint files: bundled as content for editor discovery.
       Copied to output under Recipes/Blueprints/ (preserving relative path). -->
  <ItemGroup>
    <Content Include="Recipes\Blueprints\*.bp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
