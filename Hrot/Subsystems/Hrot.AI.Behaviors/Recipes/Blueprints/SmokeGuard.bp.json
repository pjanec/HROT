  "EditorMetadata": {
    "Recipe": {
      "DisplayName": "Smoke Guard  (BP-109 smoke test)",
      "Category": "Tutorial",
      "Description": "BP-109 end-to-end smoke test asset. A second Instance blueprint, distinct from SmokePatrol, with its own local Function graph (ComputeLocal = GuardSpeed * 3, derived from this entity's own state) and a Tick graph that also calls the shared SmokeMathLib peer's Combine function, storing both results in Variables so a test can read them back.",
      "Difficulty": "Intermediate",
      "ConceptsTaught": [
        "A local Function graph (ComputeLocal) called from Tick via FunctionCall.TargetGraphId",
        "Per-entity state (GuardSpeed) feeding a derived local computation, isolated from SmokePatrol's own PatrolSpeed",
        "CallPeerBlueprint invoking the same shared Library function (SmokeMathLib.Combine) as SmokePatrol",
        "Two different Instance blueprints sharing one Function Library peer"
      ]
    }
  }
