  "EditorMetadata": {
    "Recipe": {
      "DisplayName": "List Variable Demo  (fixed-capacity lists)",
      "Category": "Tutorial",
      "Description": "Instance blueprint with a fixed-capacity list variable (Waypoints: int, capacity 4). Every tick it appends 7 via the Add (List) write node and mirrors the list's logical length into a scalar via Item Count. After four ticks the list is full and Add degrades to Ok=false — the list never overflows. Watch Waypoints render as List<Int32>[4] Count=k {…} in the debugger.",
      "Difficulty": "Beginner",
      "ConceptsTaught": [
        "Declaring a fixed-capacity list variable (Container: List (fixed))",
        "ListWrite Add — capacity-bounded, Ok=false on overflow",
        "Reading a list with the shared collection consumers (Item Count over GetVariable)",
        "Debugger watch rendering of list state"
      ]
    }
  }
