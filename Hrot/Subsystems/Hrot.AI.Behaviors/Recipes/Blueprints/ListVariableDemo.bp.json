    "Recipe": {
      "DisplayName": "List Variable Demo  (fixed-capacity lists)",
      "Category": "Tutorial",
      "Description": "Instance blueprint with a fixed-capacity list variable (Waypoints: int, capacity 4). Every tick it appends 7 via the Add (List) write node and mirrors the list\u0027s logical length into a scalar via Item Count. After four ticks the list is full and Add degrades to Ok=false \u2014 the list never overflows. Watch Waypoints render as List\u003CInt32\u003E[4] Count=k {\u2026} in the debugger.",
      "Difficulty": "Beginner",
      "ConceptsTaught": [
        "Declaring a fixed-capacity list variable (Container: List (fixed))",
        "ListWrite Add \u2014 capacity-bounded, Ok=false on overflow",
        "Reading a list with the shared collection consumers (Item Count over GetVariable)",
        "Debugger watch rendering of list state"
      ]
    }
  }
