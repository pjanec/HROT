    "Recipe": {
      "DisplayName": "Inline-Editor Types Demo",
      "Category": "Tutorial",
      "Description": "Instance blueprint showcasing inline default-value editors for all StaticTypeRegistry-supported pin types: bool, int, float, string, Vector2, Vector3, Vector4, Quaternion. Select any floating node to see its unconnected In-data pin rendered with the matching inline editor.",
      "Difficulty": "Beginner",
      "ConceptsTaught": [
        "Inline default-value editors on unconnected In-data pins",
        "Supported pin types: bool, int, float, string, Vector2, Vector3, Vector4, Quaternion, FixedString32",
        "Pure (IsPure=true) FunctionCall nodes float independently of the exec chain",
        "PinDefaultValueEditorRegistry.CreateWithBuiltins() type coverage",
        "FixedString32/64: unmanaged blittable string types registered via host-side StringPinEditor"
      ]
    }
