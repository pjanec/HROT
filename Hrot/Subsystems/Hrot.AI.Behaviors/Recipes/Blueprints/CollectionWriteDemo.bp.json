  "EditorMetadata": {
    "Recipe": {
      "DisplayName": "Collection Write Demo  (component fixed lists)",
      "Category": "Tutorial",
      "Description": "Instance blueprint that mutates a fixed-capacity collection on its OWN ECS component (BpFixedListDemo, [BlueprintWritable]). Every tick it appends 7 via the Add (Collection) write node — wired from GetComponent's collection out-pin — and mirrors the logical length into a variable via Item Count. After four ticks the component's list is full and Add degrades to Ok=false; the write is self-only and accessor-mediated (BpFixedListDemoOps).",
      "Difficulty": "Beginner",
      "ConceptsTaught": [
        "GetComponent collection out-pin → CollectionWrite \"Collection\" in-pin wiring",
        "Self-only, accessor-mediated component collection writes ([BlueprintWritable] + ops class)",
        "Capacity-bounded Add — Ok=false on overflow, never silent corruption",
        "Reading the same collection with Item Count beside the write"
      ]
    }
  }
