    "Description": null,
    "Category": null,
    "Recipe": {
      "DisplayName": "Collection Write Demo  (component fixed lists)",
      "Category": "Tutorial",
      "Description": "Instance blueprint that mutates a fixed-capacity collection on its OWN ECS component (BpFixedListDemo, [BlueprintWritable]). Every tick it appends 7 via the Add (Collection) write node \u2014 wired from GetComponent\u0027s collection out-pin \u2014 and mirrors the logical length into a variable via Item Count. After four ticks the component\u0027s list is full and Add degrades to Ok=false; the write is self-only and accessor-mediated (BpFixedListDemoOps).",
      "Difficulty": "Beginner",
      "ConceptsTaught": [
        "GetComponent collection out-pin \u2192 CollectionWrite \u0022Collection\u0022 in-pin wiring",
        "Self-only, accessor-mediated component collection writes ([BlueprintWritable] \u002B ops class)",
        "Capacity-bounded Add \u2014 Ok=false on overflow, never silent corruption",
        "Reading the same collection with Item Count beside the write"
      ]
    }
  }
