<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Animation subsystem -->
    <ProjectReference Include="..\Hrot.MuscleCharacter.Animation\Hrot.MuscleCharacter.Animation.csproj" />
    <ProjectReference Include="..\Hrot.MuscleCharacter.Animation.Fake\Hrot.MuscleCharacter.Animation.Fake.csproj" />
    
    <!-- SimHost for bootstrapper -->
    <ProjectReference Include="..\Hrot.SimHost\Hrot.SimHost.csproj" />
    
    <!-- Shared test utilities -->
    <ProjectReference Include="..\Hrot.SimHost.Integration.Tests\Hrot.SimHost.Integration.Tests.csproj" />
  </ItemGroup>

</Project>
