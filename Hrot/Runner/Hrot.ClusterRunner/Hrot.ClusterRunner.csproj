<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hrot.ClusterRunner</RootNamespace>
    <AssemblyName>Hrot.ClusterRunner</AssemblyName>
    <!-- Win32 icon embedded in the .exe PE resource. This is what the Windows taskbar / Explorer
         use (the runtime Raylib.SetWindowIcon only drives the title-bar icon). Multi-resolution
         .ico (16..256) generated from FDP\Data\Icons\HROT-icon-green.png. -->
    <ApplicationIcon>..\..\..\FDP\Data\Icons\HROT-icon-green.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Tests" />
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Integration.Tests" />  </ItemGroup>

  <ItemGroup>
    <!-- App/window icon (shown in the title bar + taskbar). Embedded so it ships with the exe
         and survives publish, mirroring the embedded icon-atlas/font pattern. Loaded by
         RaylibPresentationShell.InitWindow via Raylib.SetWindowIcon. -->
    <EmbeddedResource Include="..\..\..\FDP\Data\Icons\HROT-icon-green.png">
      <LogicalName>Hrot.ClusterRunner.HROT-icon-green.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Fdp.Engine provides ISubsystem, SubsystemConfig, IMapCameraProvider,
         SubsystemOrchestrator, HeadlessTestExecutor, and RunnerConfiguration. -->
    <ProjectReference Include="..\..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- IWindowRegistrar (uses FDP.Toolkit_ImGui.WindowManager) is in Fdp.Presentation -->
    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Presentation\Fdp.Presentation.csproj" />
    <ProjectReference Include="..\..\Network\Hrot.Network.NED\Hrot.Network.NED.csproj" />
    <ProjectReference Include="..\..\Network\Hrot.Network.BDC\Hrot.Network.BDC.csproj" />
    <PackageReference Include="CycloneDDS.NET" Version="0.3.2" />
    <!-- Subsystem libraries (R2) -->
    <ProjectReference Include="..\..\Engine\Hrot.Common\Hrot.Common.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.CGF\Hrot.CGF.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.Orchestrator\Hrot.Orchestrator.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.SimHost\Hrot.SimHost.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.IG\Hrot.IG.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.ExCon\Hrot.ExCon.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.Editor\Hrot.Editor.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.StrideMock\Hrot.StrideMock.csproj" />
    <ProjectReference Include="..\..\Engine\Hrot.Presentation\Hrot.Presentation.csproj" />
    <!-- IScenario + ScenarioSubsystem for mode ci -->
    <ProjectReference Include=".\..\..\..\FDP\Examples\Fdp.Examples.Common\Fdp.Examples.Common.csproj" />
    <!-- Ensures Hrot.AI.Behaviors.dll is copied to the output directory for hot-reload.
         No types from this assembly are used statically; the C# compiler strips the
         IL reference, but MSBuild copy-local mechanics still deliver the DLL. -->
    <ProjectReference Include="..\..\Subsystems\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.ReplayBrowser\Hrot.ReplayBrowser.csproj" />  </ItemGroup>

  <!--
    ⭐⭐⭐ Batch 103 (103a) — THE SHIPPED DEFAULT LAYOUT reaches the output directory.

    📄 docs/UX/UX_Feature_Layout_Defaults.md. 🔒 The user's ruling: the json lives NEXT TO the imgui.ini
    in BOTH places, so "the layout" is a DIRECTORY and a reset is a directory copy — ⛔ not two
    special-cased files. Adding a third layout file later needs no build change, only a new file.

    ⚠ Flattened to `layout/` in the output (Link), because LayoutPaths.ShippedDefaultDirectory looks
    there. ⛔ The SOURCE keeps `layout/default/` so the tree says which layout it is.
  -->
  <ItemGroup>
    <Content Include="..\..\..\layout\default\imgui.ini" Link="layout\imgui.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\layout\default\fdp_windows.json" Link="layout\fdp_windows.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImGui-cs" Version="3.2.0" />  </ItemGroup>

</Project>
