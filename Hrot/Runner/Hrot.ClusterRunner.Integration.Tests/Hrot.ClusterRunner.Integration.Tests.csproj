<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>xUnit1030;xUnit1031;xUnit2013;xUnit2020;CS8602;CS8604</NoWarn>
    <!-- P3D-201: EqsResult now carries PositionZ; activates the flat-terrain Z≈0 parity assertion. -->
    <DefineConstants>$(DefineConstants);EQS_HAS_POSITIONZ</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hrot.ClusterRunner\Hrot.ClusterRunner.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.AI.Behaviors\Hrot.AI.Behaviors.csproj" />
    <ProjectReference Include="..\..\Subsystems\Hrot.Editor\Hrot.Editor.csproj" />
    <ProjectReference Include="..\..\Network\Hrot.Network.NED\Hrot.Network.NED.csproj" />

    <ProjectReference Include="..\..\..\FDP\Engine\Fdp.Presentation\Fdp.Presentation.csproj" />
    <ProjectReference Include="..\..\Engine\Hrot.Presentation\Hrot.Presentation.csproj" />
    <ProjectReference Include="..\..\..\FDP\Examples\Fdp.Examples.Scenarios\Fdp.Examples.Scenarios.csproj" />
    <!-- PACK3-Z006: ZoneScenarioLoadIntegrationTests uses ZoneEnvironmentData and PhysicsCollider directly -->  </ItemGroup>

  <ItemGroup>
    <Content Include="TestScripts\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>  </ItemGroup>

