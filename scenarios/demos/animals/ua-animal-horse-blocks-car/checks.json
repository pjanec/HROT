{
  "$doc": "docs/DESIGN_Scenario_Regression.md \u00a73 \u2014 CE-3457 a vehicle yields to an animal in its lane, one row per Judge line. The area's horse is 'Horse 1' ('*Horse ' with the space names it, not the area).",
  "runFor": 60,
  "golden": {
    "every": 10
  },
  "later": [
    "Horse 1"
  ],
  "expect": [
    {
      "name": "the horse is on the lane",
      "on": "field",
      "who": "*Horse ",
      "path": "SimTransform.Position.1",
      "op": "<",
      "value": 12.5
    },
    {
      "name": "the car gets under way",
      "on": "field",
      "who": "Car",
      "path": "SimTransform.Position.0",
      "op": ">",
      "value": 50
    },
    {
      "name": "then the car stands",
      "on": "field",
      "who": "Car",
      "path": "VehicleState.Speed",
      "op": "<",
      "value": 0.3,
      "after": "the car gets under way"
    },
    {
      "name": "the car stops short of the horse",
      "never": {
        "on": "field",
        "who": "Car",
        "path": "SimTransform.Position.0",
        "op": ">",
        "value": 96
      },
      "before": "then the car stands"
    },
    {
      "name": "the horse is never hurt",
      "never": {
        "on": "field",
        "who": "*Horse ",
        "path": "Health.Current",
        "op": "<",
        "value": 100
      }
    }
  ]
}