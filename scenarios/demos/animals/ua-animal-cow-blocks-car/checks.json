{
  "$doc": "docs/DESIGN_Scenario_Regression.md \u00a73 \u2014 CE-3457 a vehicle yields to an animal in its lane, one row per Judge line. The area's cow is 'Cow 1' ('*Cow ' with the space names it, not the area).",
  "runFor": 60,
  "golden": {
    "every": 10
  },
  "later": [
    "Cow 1"
  ],
  "expect": [
    {
      "name": "the cow is on the lane",
      "on": "near",
      "who": "*Cow ",
      "point": [
        100,
        10
      ],
      "within": 4
    },
    {
      "name": "the car gets under way",
      "on": "field",
      "who": "Car",
      "path": "SimTransform.Position.0",
      "op": ">",
      "value": 50
    },
    {
      "name": "then the car stands",
      "on": "field",
      "who": "Car",
      "path": "VehicleState.Speed",
      "op": "<",
      "value": 0.3,
      "after": "the car gets under way"
    },
    {
      "name": "the car stays short of the cow's spot",
      "never": {
        "on": "field",
        "who": "Car",
        "path": "SimTransform.Position.0",
        "op": ">",
        "value": 95
      }
    },
    {
      "name": "the cow is never hurt",
      "never": {
        "on": "field",
        "who": "*Cow ",
        "path": "Health.Current",
        "op": "<",
        "value": 100
      }
    }
  ]
}