{
  "$doc": "docs/DESIGN_Scenario_Regression.md §3 — CE-4623 the herd on the road, one row per Judge line. The area's cattle are 'Herd 1'..'Herd 6' ('*Herd ' with the space names them, not the area).",
  "runFor": 90,
  "golden": {
    "every": 10
  },
  "later": [
    "Herd 1",
    "Herd 2",
    "Herd 3",
    "Herd 4",
    "Herd 5",
    "Herd 6"
  ],
  "expect": [
    {
      "name": "the herd is on the lane",
      "on": "field",
      "who": "*Herd ",
      "path": "TkbIdentity.TkbType",
      "op": "==",
      "value": 700,
      "quantifier": "atLeast:4",
      "before": "the convoy panics the herd"
    },
    {
      "name": "the convoy panics the herd",
      "on": "field",
      "who": "*Herd ",
      "path": "AnimalState.FearBand",
      "op": ">=",
      "value": 3,
      "quantifier": "atLeast:3"
    },
    {
      "name": "the herd flees",
      "on": "field",
      "who": "*Herd ",
      "path": "AnimalState.Mode",
      "op": "==",
      "value": "Flee",
      "quantifier": "atLeast:3",
      "after": "the convoy panics the herd"
    },
    {
      "name": "the cattle leave the lane",
      "never": {
        "on": "near",
        "who": "*Herd ",
        "point": [
          150,
          10
        ],
        "within": 5
      },
      "after": "the convoy goes on past the herd's spot"
    },
    {
      "name": "the convoy goes on past the herd's spot",
      "on": "field",
      "who": "Convoy APC 1",
      "path": "SimTransform.Position.0",
      "op": ">",
      "value": 175,
      "after": "the herd flees"
    },
    {
      "name": "no cow is run over",
      "never": {
        "on": "field",
        "who": "*Herd ",
        "path": "Health.Current",
        "op": "<",
        "value": 100
      }
    }
  ]
}