{
  "$doc": "\u00a723.6 ST-5. Bands: ResolutionBands.Default (400 m + 200 m lead, forced 300 m). The posts are UnitSplits.FallbackPosts (D-P5): D-P3's planned posts are STOPPED (R-8330), so 'sensible positions' = the fallback rows round the unit. A rifle platoon (type 305) has no vehicles - the 'soldiers and vehicles' half of the Judge line is not exercised. The children carry no name (F-22): they are addressed by network id (measured: the children are 1008-1037 in slot order) (R-8335). The author's policy sets the merge margin to 250 m (merge beyond 650 m, past the 600 m trigger; F-23, R-8336).",
  "runFor": 150,
  "golden": {
    "every": 25
  },
  "anchors": {
    "band": {
      "on": "near",
      "who": "*Red Patrol",
      "point": [
        300,
        300,
        0
      ],
      "within": 600
    },
    "handover": {
      "on": "field",
      "who": "Blue Stochastic Platoon",
      "path": "AggregateUnit.Resolution",
      "op": "==",
      "value": "Physical"
    }
  },
  "expect": [
    {
      "name": "the platoon stays stochastic while the patrol is beyond the band (400 m + 200 m lead)",
      "never": {
        "on": "field",
        "who": "Blue Stochastic Platoon",
        "path": "AggregateUnit.Splitting",
        "op": "!=",
        "value": "NotSplitting"
      },
      "before": "band"
    },
    {
      "name": "the patrol inside the band starts the process: Planning (a step of its own - not forced)",
      "on": "field",
      "who": "Blue Stochastic Platoon",
      "path": "AggregateUnit.Splitting",
      "op": "==",
      "value": "Planning",
      "after": "band",
      "before": "band+5"
    },
    {
      "name": "... then Materialising (the children created, held)",
      "on": "field",
      "who": "Blue Stochastic Platoon",
      "path": "AggregateUnit.Splitting",
      "op": "==",
      "value": "Materialising",
      "after": "band",
      "before": "band+10"
    },
    {
      "name": "the handover: the platoon is Physical",
      "on": "field",
