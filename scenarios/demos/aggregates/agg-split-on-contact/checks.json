  "expect": [
    {
      "name": "the platoon stays stochastic while the patrol is beyond the band (400 m + 200 m lead)",
      "never": {
        "on": "field",
        "who": "Blue Stochastic Platoon",
        "path": "AggregateUnit.Splitting",
        "op": "!=",
        "value": "NotSplitting"
      },
      "before": "band"
    },
    {
      "name": "the patrol inside the band starts the process: Planning (a step of its own - not forced)",
      "on": "field",
      "who": "Blue Stochastic Platoon",
      "path": "AggregateUnit.Splitting",
      "op": "==",
      "value": "Planning",
      "after": "band",
      "before": "band+5"
    },
    {
      "name": "... then Materialising (the children created, held)",
      "on": "field",
      "who": "Blue Stochastic Platoon",
      "path": "AggregateUnit.Splitting",
      "op": "==",
      "value": "Materialising",
      "after": "band",
      "before": "band+10"
    },
    {
      "name": "the handover: the platoon is Physical",
      "on": "field",
      "who": "Blue Stochastic Platoon",
      "path": "AggregateUnit.Resolution",
      "op": "==",
      "value": "Physical",
      "after": "band",
      "before": "band+20"
