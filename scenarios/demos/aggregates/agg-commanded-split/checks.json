    "Blue Stochastic Squad/3",
    "Blue Stochastic Squad/4",
    "Blue Stochastic Squad/5",
    "Blue Stochastic Squad/6",
    "Blue Stochastic Squad/7",
    "Blue Stochastic Squad/8",
    "Blue Stochastic Squad/9",
