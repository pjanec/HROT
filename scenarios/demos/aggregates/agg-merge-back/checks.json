  "golden": {
    "every": 40
  },
  "do": [
    {
      "name": "the instructor pins it Physical",
      "at": 250,
      "set": {
        "who": "Blue Stochastic Platoon",
        "component": "AggregateUnit",
        "patch": {
          "Pin": "PinPhysical"
        }
      }
    }
  ],
