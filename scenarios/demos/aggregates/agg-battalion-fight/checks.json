{
  "$doc": "\u00a723.6 ST-4. 'A side broken' is the measured end: the Blue assault company (Blue Company 2) is destroyed within seconds of contact (all 90 slots down by 335 s at GAP 1500 / 335 s at 600), its HQ hears TaskFailed and reads it Black; the base-of-fire company (1) Sets and the reserve (3) never engage. After agg-backend's calibration (CE-8009 R-8005: focused hits, broken men still firing at 0.6) the assault costs Red companies 1 and 2 ten or more men each (Amber), company 3 under ten (Green) - measured 2026-11-16; reverting 5d8a30150 alone restores the old all-Green outcome (R-8332). The census is the HoldArea objective of ObjectiveCensus (a stochastic unit under a physical subject's roster counts its Present). ROWS",
  "runFor": 450,
  "golden": {
    "every": 50
  },
  "expect": [
    {
      "name": "the Blue HQ runs CompanyAttack",
      "on": "task",
      "who": "Blue Battalion HQ",
      "is": "CompanyAttack",
      "before": 10
    },
    {
      "name": "the Red HQ runs CompanyDefend",
      "on": "task",
      "who": "Red Battalion HQ",
      "is": "CompanyDefend",
      "before": 10
    },
    {
      "name": "the assault company is ordered by KIND: the generic Attack play",
      "on": "task",
      "who": "Blue Company 2",
      "is": "StochasticUnitAttack",
      "before": 10
    },
    {
      "name": "the census: the Blue HQ's three companies hold 270 slot-table men in the area",
      "on": "field",
      "who": "Blue Battalion Census",
      "path": "ObjectiveStatus.State",
      "op": "==",
      "value": "Achieved",
      "before": 20
    },
    {
      "name": "the census: the Red HQ's three companies hold 270 slot-table men in the area",
      "on": "field",
      "who": "Red Battalion Census",
      "path": "ObjectiveStatus.State",
      "op": "==",
      "value": "Achieved",
      "before": 20
    },
    {
      "name": "the HQ hears the assault company is lost (PROGRESS TaskFailed): the fight has run to an end",
      "on": "field",
      "who": "Blue Battalion HQ",
      "path": "CommandPicture.Subordinates.1.Progress",
      "op": "==",
      "value": "TaskFailed",
      "before": 440
    },
    {
      "name": "the assault company's slot table agrees: every slot is down",
      "on": "field",
      "who": "Blue Company 2",
      "path": "UnitSlotTable.Slots.*.Health",
      "op": "<",
      "value": 0.5,
      "atEnd": true,
      "where": {
        "CompositeSlot": [
          ">",
          0
        ]
      },
      "elements": 90
    },
    {
      "name": "... and its SITREP colour at the HQ is Black",
      "on": "field",
      "who": "Blue Battalion HQ",
      "path": "CommandPicture.Subordinates.1.Strength",
      "op": "==",
      "value": "Black",
      "atEnd": true
    },
    {
      "name": "the base-of-fire company has lost nobody: its SITREP colour is Green",
      "on": "field",
      "who": "Blue Battalion HQ",
      "path": "CommandPicture.Subordinates.0.Strength",
      "op": "==",
      "value": "Green",
      "atEnd": true
    },
    {
      "name": "... and its slot table agrees (no slot down)",
      "never": {
        "on": "field",
        "who": "Blue Company 1",
        "path": "UnitSlotTable.Slots.*.Health",
        "op": "<",
        "value": 0.5,
        "where": {
          "CompositeSlot": [
            ">",
            0
          ]
        }
      }
    },
    {
      "name": "Red's SITREP colours: company 3, untouched by the assault, reads Green",
      "on": "field",
      "who": "Red Battalion HQ",
      "path": "CommandPicture.Subordinates.0.Strength",
      "op": "==",
      "value": "Green",
      "atEnd": true
    },
    {
      "name": "... and its slot table agrees (fewer than 10 of 90 down: >= 90 % present)",
      "never": {
        "on": "field",
        "who": "Red Company 3",
        "path": "UnitSlotTable.Slots.*.Health",
        "op": "<",
        "value": 0.5,
        "where": {
          "CompositeSlot": [
            ">",
            0
          ]
