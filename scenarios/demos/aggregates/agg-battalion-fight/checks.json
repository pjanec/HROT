      "on": "field",
      "who": "Red Battalion HQ",
      "path": "CommandPicture.Subordinates.2.Strength",
      "op": "==",
      "value": "Amber",
      "atEnd": true
    },
    {
      "name": "... and company 2's slot table agrees (at least 10 down)",
