{
  "$doc": "DESIGN_Air_Combat \u00a76 S2 / \u00a78e \u2014 feature (golden).",
  "runFor": 150,
  "golden": {
    "every": 10
  },
  "anchors": {
    "defended": {
      "on": "field",
      "who": "Viper",
      "path": "MissileDefenceState.Count",
      "op": ">=",
      "value": 1
    }
  },
  "expect": [
    {
      "name": "a SAM fires (the radar SAM or the Stinger \u2014 both names hold an 'S')",
      "on": "shot",
      "by": "*S",
      "n": 1
    },
    {
      "name": "the F-16 beams",
      "on": "field",
      "who": "Viper",
      "path": "MissileDefenceState.Phase",
      "op": "in",
      "value": [
        "Beam",
        2
      ]
    },
    {
      "name": "it drops decoys",
      "on": "field",
      "who": "Viper",
      "path": "MissileDefenceState.DecoysTotal",
      "op": ">=",
      "value": 1
    },
    {
      "name": "a SAM missile is defeated",
      "on": "shot",
      "by": "*S",
      "n": 1,
      "where": {
        "outcome": "Defeated"
      }
    },
    {
      "name": "Viper is never lost",
      "never": {
        "on": "field",
        "who": "Viper",
        "path": "Health.Current",
        "op": "<=",
        "value": 0
      }
    },
    {
      "name": "the route resumes: never back at its first waypoint after the defence",
      "never": {
        "on": "close",
        "who": "Viper",
        "point": [
          -3000,
          500
        ],
        "m": 500
      },
      "after": "defended"
    },
    {
      "name": "the route resumes: it reaches its last waypoint",
      "on": "close",
      "who": "Viper",
      "point": [
        9000,
        -1500
      ],
      "m": 600,
      "after": "defended"
    }
  ]
}
