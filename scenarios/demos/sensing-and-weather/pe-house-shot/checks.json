      "metric": "matched",
      "op": "==",
      "value": 1,
      "for": 5,
      "after": "first shot"
    },
    {
      "name": "the squad never counts him twice",
      "never": {
        "on": "perceives",
        "who": "Blue Squad",
        "squad": true,
        "truth": "*Red",
        "metric": "duplicate",
        "op": ">",
        "value": 0
      },
