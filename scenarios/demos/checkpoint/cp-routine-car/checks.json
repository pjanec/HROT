  {
   "name": "the car is searched and released",
   "on": "field",
   "who": "Checkpoint",
   "path": "CheckpointWatch.Released",
   "op": ">=",
   "value": 1
  },
  {
   "name": "the driver boards again after the release",
   "on": "embark",
   "who": "Driver",
   "is": true,
   "after": "the car is searched and released"
  },
  {
   "name": "nobody fires at it",
   "never": {
    "on": "shot"
   }
  },
  {
   "name": "never a threat",
   "never": {
    "on": "field",
    "who": "Checkpoint",
    "path": "CheckpointWatch.Threats",
    "op": ">=",
    "value": 1
   }
  }
 ]
