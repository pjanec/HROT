{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-sight-empty (SD-S4). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 11,
  "golden": {
    "every": 5
  },
  "do": [
    {
      "name": "emptied",
      "at": 0.1,
      "set": {
        "who": "TOW",
        "component": "WeaponState",
        "patch": {
          "Ammo": 0,
          "MagazineRounds": 0
        }
      }
    },
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Gunner",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "station": 1,
        "source": "Launcher sight unit"
      }
    },
    {
      "name": "aimed",
      "at": 1.2,
      "control": {
        "aim": "Target"
      }
    },
    {
      "name": "power",
      "at": 2.0,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "arm",
      "at": 6.0,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "fire",
      "at": 6.5,
      "control": {
        "station": 1,
        "press": "FIRE"
      }
    },
    {
      "name": "arm again",
      "at": 7.0,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "paused",
      "at": 8.0,
      "pause": {
        "frames": 60
      }
    },
    {
      "name": "arm in pause",
      "atPausedFrame": 20,
      "control": {
        "press": "ARM"
      }
    }
  ],
  "expect": [
    {
      "name": "POWER and the test end in STANDBY",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": "power+3.5",
      "before": "arm"
    },
    {
      "name": "MISSILES 0 (NO MISSILE) from the test's end",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Missiles",
      "op": "==",
      "value": 0,
      "after": "power+3.5"
    },
    {
      "name": "the unit never arms an empty launcher (ARM refused, also in the pause)",
      "never": {
        "on": "field",
        "who": "Launcher sight unit",
        "memory": "FireControlUnitState",
        "field": "Phase",
        "op": "==",
        "value": "Armed"
      },
      "after": "viewed"
    },
    {
      "name": "never GUIDING",
      "never": {
        "on": "field",
        "who": "Launcher sight unit",
        "memory": "FireControlUnitState",
        "field": "Phase",
        "op": "==",
        "value": "Guiding"
      },
      "after": "viewed"
    },
    {
      "name": "never READY",
      "never": {
        "on": "field",
        "who": "Launcher sight unit",
        "memory": "FireControlUnitState",
        "field": "Ready",
        "op": "==",
        "value": 1
      },
      "after": "viewed"
    },
    {
      "name": "never a launch",
      "never": {
        "on": "shot",
        "by": "TOW"
      }
    },
    {
      "name": "it stays in STANDBY to the end - the ARM press in the pause is not carried to the first live frame",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": "paused+1.0"
    }
  ]
}
