{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-drone-paused (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 20,
  "golden": {
    "every": 5
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Operator"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Drone station"
      }
    },
    {
      "name": "powered",
      "at": 1.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "armed",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "takeoff",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "TAKEOFF"
      }
    },
    {
      "name": "paused",
      "at": 9.0,
      "pause": {
        "frames": 120
      }
    },
    {
      "name": "cam down in pause",
      "atPausedFrame": 10,
      "control": {
        "press": "CAM DOWN"
      }
    },
    {
      "name": "land in pause",
      "atPausedFrame": 30,
      "control": {
        "press": "LAND"
      }
    }
  ],
  "expect": [
    {
      "name": "the gimbal tilts inside the pause (paused frame 20)",
      "atPausedFrame": 20,
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "CameraPitch",
      "op": "<",
      "value": -0.2
    },
    {
      "name": "the station's view tilts with it (paused frame 20)",
      "atPausedFrame": 20,
      "on": "field",
      "who": "Drone station",
      "path": "DeviceView.Pitch",
      "op": "<",
      "value": -0.2
    },
    {
      "name": "LAND is queued, not acted, in the pause (paused frame 60)",
      "atPausedFrame": 60,
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Queued",
      "op": "==",
      "value": 4,
      "also": [
        {
          "path": "Command",
          "op": "==",
          "value": "Fly"
        }
      ]
    },
    {
      "name": "the drone hovers in the pause (paused frame 100)",
      "atPausedFrame": 100,
      "on": "field",
      "who": "Drone",
      "path": "DroneLink.Phase",
      "op": "==",
      "value": "Manual"
    },
    {
      "name": "the drone never moves in the pause",
      "never": {
        "on": "far",
        "who": "Drone",
        "point": [
          -296,
          -400
        ],
        "m": 0.25
      },
      "after": "paused",
      "before": "paused"
    },
    {
      "name": "the queued LAND is the command after the pause",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Command",
      "op": "==",
      "value": "Land",
      "after": 9.5
    },
    {
      "name": "it lands where it hovered",
      "on": "field",
      "who": "Drone",
      "path": "FlightState.Airborne",
      "op": "==",
      "value": 0,
      "atEnd": true
    },
    {
      "name": "… on its launch point",
      "on": "close",
      "who": "Drone",
      "point": [
        -296,
        -400
      ],
      "m": 2,
      "atEnd": true
    },
    {
      "name": "the OSD shows LAND queued in the pause (paused frame 60)",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "queued"
      ],
      "atPausedFrame": 60
    }
  ]
}
