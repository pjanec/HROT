{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-ltd-linked (SD-S5c). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 8,
  "golden": {
    "every": 4
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "station": 1,
        "source": "Rangefinder"
      }
    },
    {
      "name": "aimed",
      "at": 1.5,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "ranged",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    },
    {
      "name": "designator viewed",
      "at": 3.0,
      "view": {
        "station": 1,
        "source": "Designator"
      }
    },
    {
      "name": "powered",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "rangefinder viewed",
      "at": 4.0,
      "view": {
        "station": 1,
        "source": "Rangefinder"
      }
    },
    {
      "name": "sent",
      "at": 4.5,
      "control": {
        "station": 1,
        "press": "SEND"
      }
    },
    {
      "name": "designator viewed again",
      "at": 5.5,
      "view": {
        "station": 1,
        "source": "Designator"
      }
    }
  ],
  "expect": [
    {
      "name": "the rangefinder measured the marker",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 447.0,
      "after": "ranged",
      "before": "sent",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        }
      ]
    },
    {
      "name": "the designator is on",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": "powered",
      "before": "rangefinder viewed"
    },
    {
      "name": "before SEND the designator holds no target",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "HasTarget",
      "op": "==",
      "value": 0,
      "after": "powered",
      "before": "sent"
    },
    {
      "name": "SEND hands the target to the linked designator",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "HasTarget",
      "op": "==",
      "value": 1,
      "after": "sent",
      "also": [
        {
          "path": "Target.Point.X",
          "op": ">=",
          "value": -133.8
        },
        {
          "path": "Target.Point.X",
          "op": "<=",
          "value": -129.8
        },
        {
          "path": "Target.Point.Y",
          "op": ">=",
          "value": 16.2
        },
        {
          "path": "Target.Point.Y",
          "op": "<=",
          "value": 20.2
        },
        {
          "path": "Target.Range",
          "op": ">=",
          "value": 447.0
        },
        {
          "path": "Target.Range",
          "op": "<=",
          "value": 450.5
        },
        {
          "path": "Target.FromType",
          "op": "==",
          "value": 640
        }
      ]
    },
    {
      "name": "the target came from the rangefinder",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "TargetFrom",
      "op": "==",
      "value": "Rangefinder",
      "after": "sent"
    },
    {
      "name": "the designator's HUD draws the received-target cue",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "TARGET"
      ],
      "after": "designator viewed again+0.25"
    },
    {
      "name": "the cue names its sender and the link",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "from LASER RANGEFINDER (linked)"
      ],
      "after": "designator viewed again+0.25"
    }
  ]
}
