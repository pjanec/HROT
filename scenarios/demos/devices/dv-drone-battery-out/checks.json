{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-drone-battery-out (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 60,
  "golden": {
    "every": 15
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Operator"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Drone station"
      }
    },
    {
      "name": "powered",
      "at": 1.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "armed",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "takeoff",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "TAKEOFF"
      }
    },
    {
      "name": "fly",
      "at": 7.0,
      "control": {
        "axis": {
          "3": 0.4
        },
        "for": 20
      }
    }
  ],
  "expect": [
    {
      "name": "the battery runs out",
      "on": "field",
      "who": "Drone",
      "path": "DroneBattery.Remaining01",
      "op": "==",
      "value": 0,
      "after": "fly"
    },
    {
      "name": "down where it is",
      "on": "field",
      "who": "Drone",
      "path": "DroneLink.Phase",
      "op": "==",
      "value": "BatteryDown",
      "after": "fly"
    },
    {
      "name": "the station shows it coming down",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Landing",
      "after": "fly"
    },
    {
      "name": "it is down at the end",
      "on": "field",
      "who": "Drone",
      "path": "FlightState.Airborne",
      "op": "==",
      "value": 0,
      "atEnd": true
    },
    {
      "name": "far from home: it came down where it was",
      "on": "far",
      "who": "Drone",
      "point": [
        -296,
        -400
      ],
      "m": 150,
      "atEnd": true
    }
  ]
}
