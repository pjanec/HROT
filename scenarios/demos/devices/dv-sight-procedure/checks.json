{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-sight-procedure (SD-S4). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 24,
  "golden": {
    "every": 6
  },
  "do": [
    {
      "name": "loaded",
      "at": 0.1,
      "set": {
        "who": "TOW",
        "component": "WeaponState",
        "patch": {
          "Ammo": 1,
          "MagazineRounds": 1
        }
      }
    },
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Gunner",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "station": 1,
        "source": "Launcher sight unit"
      }
    },
    {
      "name": "aimed",
      "at": 1.2,
      "control": {
        "aim": "Target"
      }
    },
    {
      "name": "fire early",
      "at": 2.0,
      "control": {
        "station": 1,
        "press": "FIRE"
      }
    },
    {
      "name": "power",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "arm early",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "armed",
      "at": 6.5,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "paused",
      "at": 7.0,
      "pause": {
        "frames": 60
      }
    },
    {
      "name": "fire in pause",
      "atPausedFrame": 20,
      "control": {
        "press": "FIRE"
      }
    },
    {
      "name": "fire",
      "at": 9.0,
      "control": {
        "station": 1,
        "press": "FIRE"
      }
    },
    {
      "name": "arm again",
      "at": 18.0,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "fire again",
      "at": 19.0,
      "control": {
        "station": 1,
        "press": "FIRE"
      }
    }
  ],
  "expect": [
    {
      "name": "the unit is OFF until POWER",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Off",
      "after": "viewed",
      "before": "power"
    },
    {
      "name": "POWER starts the self-test",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Test",
      "after": "power+0.5",
      "before": "power+2.5"
    },
    {
      "name": "ARM before the test ends is refused",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Test",
      "after": "arm early+0.2",
      "before": "arm early+1.0"
    },
    {
      "name": "the test ends in STANDBY",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": "power+3.5",
      "before": "armed"
    },
    {
      "name": "never ARMED before ARM is accepted",
      "never": {
        "on": "field",
        "who": "Launcher sight unit",
        "memory": "FireControlUnitState",
        "field": "Phase",
        "op": "==",
        "value": "Armed"
      },
      "after": "viewed",
      "before": "armed"
    },
    {
      "name": "ARM arms it",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Armed",
      "after": "armed+0.2",
      "before": "paused"
    },
    {
      "name": "READY when armed on a live frame",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Ready",
      "op": "==",
      "value": 1,
      "after": "armed+0.2",
      "before": "paused"
    },
    {
      "name": "READY is off in the pause",
      "atPausedFrame": 40,
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Ready",
      "op": "==",
      "value": 0
    },
    {
      "name": "still ARMED after FIRE in the pause (refused, never remembered)",
      "atPausedFrame": 40,
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Armed"
    },
    {
      "name": "the refused press is not carried to the first live frame",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Armed",
      "after": "paused+0.5",
      "before": "fire"
    },
    {
      "name": "no launch before FIRE on a live armed unit (FIRE early, in the pause)",
      "never": {
        "on": "shot",
        "by": "TOW"
      },
      "after": "viewed",
      "before": "fire"
    },
    {
      "name": "FIRE launches the missile",
      "on": "shot",
      "by": "TOW",
      "n": 1,
      "after": "fire"
    },
    {
      "name": "GUIDING while it flies",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Guiding",
      "after": "fire+0.3",
      "before": "fire+1.0"
    },
    {
      "name": "the missile hits the man the trainee held the crosshair on (the round flew the device's sight line)",
      "on": "field",
      "who": "Target",
      "path": "Health.Current",
      "op": "<=",
      "value": 0,
      "after": "fire"
    },
    {
      "name": "the flight ends in STANDBY: the launcher is empty (NO MISSILE)",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": "fire+6.0",
      "before": "arm again"
    },
    {
      "name": "MISSILES 0",
      "on": "field",
      "who": "Launcher sight unit",
      "memory": "FireControlUnitState",
      "field": "Missiles",
      "op": "==",
      "value": 0,
      "after": "arm again-0.5"
    },
    {
      "name": "never ARMED after the flight (ARM refused on the emptied launcher, D-112)",
      "never": {
        "on": "field",
        "who": "Launcher sight unit",
        "memory": "FireControlUnitState",
        "field": "Phase",
        "op": "==",
        "value": "Armed"
      },
      "after": "fire+1.0"
    },
    {
      "name": "never a second launch",
      "never": {
        "on": "shot",
        "by": "TOW",
        "n": 2
      },
      "after": "fire"
    }
  ]
}
