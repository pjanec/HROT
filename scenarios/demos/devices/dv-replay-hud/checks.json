{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-replay-hud (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 6,
  "golden": {
    "every": 1
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Rangefinder"
      }
    },
    {
      "name": "aimed",
      "at": 1.2,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "paused",
      "at": 2.0,
      "pause": {
        "frames": 120
      }
    },
    {
      "name": "menu in pause",
      "atPausedFrame": 10,
      "control": {
        "press": "MENU"
      }
    },
    {
      "name": "ranged in pause",
      "atPausedFrame": 40,
      "control": {
        "press": "RANGE"
      }
    }
  ],
  "expect": [
    {
      "name": "the menu opens inside the pause (paused frame 20)",
      "atPausedFrame": 20,
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "MenuOpen",
      "op": "==",
      "value": 1
    },
    {
      "name": "the range is measured inside the pause (paused frame 80)",
      "atPausedFrame": 80,
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 447.0,
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        },
        {
          "path": "HasRange",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "name": "a range measured in pause is a PREVIEW",
      "atPausedFrame": 80,
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "RangePreview",
      "op": "==",
      "value": 1
    },
    {
      "name": "the HUD shows the preview range (paused frame 100)",
      "atPausedFrame": 100,
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "450 m"
      ]
    },
    {
      "name": "the HUD tags it PREVIEW",
      "atPausedFrame": 100,
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "PREVIEW"
      ]
    },
    {
      "name": "the marker never moves in the pause",
      "never": {
        "on": "far",
        "who": "Marker 450",
        "point": [
          318.2,
          318.2
        ],
        "m": 0.25
      },
      "after": "paused",
      "before": "paused"
    },
    {
      "name": "the observer never moves in the pause",
      "never": {
        "on": "far",
        "who": "Observer",
        "point": [
          0,
          0
        ],
        "m": 0.25
      },
      "after": "paused",
      "before": "paused"
    },
    {
      "name": "no shot is fired in the pause",
      "never": {
        "on": "shot",
        "by": "*"
      },
      "after": "paused",
      "before": "paused"
    }
  ]
}
