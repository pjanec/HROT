{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-switch-devices (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 9,
  "golden": {
    "every": 3
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer"
      }
    },
    {
      "name": "binoculars viewed",
      "at": 1.5,
      "view": {
        "source": "Binoculars"
      }
    },
    {
      "name": "zoomed",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "ZOOM IN"
      }
    },
    {
      "name": "rangefinder viewed",
      "at": 4.0,
      "view": {
        "source": "Rangefinder"
      }
    },
    {
      "name": "moded",
      "at": 5.0,
      "control": {
        "station": 1,
        "press": "MODE"
      }
    },
    {
      "name": "eye",
      "at": 6.5,
      "view": {
        "source": "none"
      }
    }
  ],
  "expect": [
    {
      "name": "the view shows the binoculars' HUD",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "BINOCULARS"
      ],
      "after": "binoculars viewed",
      "before": "rangefinder viewed"
    },
    {
      "name": "the binoculars' view never shows the rangefinder",
      "never": {
        "on": "hud",
        "source": "station:1",
        "text": [
          "==",
          "LASER RANGEFINDER"
        ]
      },
      "after": "binoculars viewed+0.25",
      "before": "rangefinder viewed"
    },
    {
      "name": "after the re-bind the view shows the rangefinder's HUD",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "LASER RANGEFINDER"
      ],
      "after": "rangefinder viewed",
      "before": "eye"
    },
    {
      "name": "the rangefinder's view never shows the binoculars",
      "never": {
        "on": "hud",
        "source": "station:1",
        "text": [
          "==",
          "BINOCULARS"
        ]
      },
      "after": "rangefinder viewed+0.25",
      "before": "eye"
    },
    {
      "name": "the plain eye shows no device HUD",
      "on": "hud",
      "source": "station:1",
      "count": [
        "==",
        0
      ],
      "after": "eye+0.25"
    },
    {
      "name": "ZOOM IN steps the binoculars to 10x",
      "on": "field",
      "who": "Binoculars",
      "memory": "BinocularsState",
      "field": "Zoom",
      "op": "==",
      "value": 2,
      "after": "zoomed"
    },
    {
      "name": "the rangefinder is untouched by the binoculars' press",
      "never": {
        "on": "field",
        "who": "Rangefinder",
        "memory": "RangefinderState",
        "field": "Mode",
        "op": "!=",
        "value": "Single"
      },
      "after": "possessed",
      "before": "moded"
    },
    {
      "name": "MODE steps the rangefinder to CONTINUOUS",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Mode",
      "op": "==",
      "value": "Continuous",
      "after": "moded"
    },
    {
      "name": "the binoculars are untouched by the rangefinder's press",
      "never": {
        "on": "field",
        "who": "Binoculars",
        "memory": "BinocularsState",
        "field": "Zoom",
        "op": "!=",
        "value": 2
      },
      "after": "zoomed+0.5"
    },
    {
      "name": "he raises the binoculars while the view shows them",
      "on": "field",
      "who": "Observer",
      "path": "WeaponPosture.HeldItem",
      "op": "==",
      "value": "Binoculars",
      "after": "binoculars viewed",
      "before": "rangefinder viewed"
    },
    {
      "name": "the optic stays raised while the view shows a hand-held device",
      "never": {
        "on": "field",
        "who": "Observer",
        "path": "WeaponPosture.HeldItem",
        "op": "!=",
        "value": "Binoculars"
      },
      "after": "binoculars viewed+0.5",
      "before": "eye"
    },
    {
      "name": "he lowers it when the view returns to the eye",
      "on": "field",
      "who": "Observer",
      "path": "WeaponPosture.HeldItem",
      "op": "!=",
      "value": "Binoculars",
      "after": "eye"
    }
  ]
}
