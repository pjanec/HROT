{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-stacked-devices (SD-S5b). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 8,
  "golden": {
    "every": 4
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "station": 1,
        "source": "Rangefinder"
      }
    },
    {
      "name": "aimed",
      "at": 1.5,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "ranged",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    },
    {
      "name": "sent",
      "at": 4.0,
      "control": {
        "station": 1,
        "press": "SEND"
      }
    },
    {
      "name": "binoculars viewed",
      "at": 5.5,
      "view": {
        "station": 1,
        "source": "Binoculars"
      }
    }
  ],
  "expect": [
    {
      "name": "the stacked binoculars sit in the rangefinder's station",
      "on": "field",
      "who": "Binoculars",
      "path": "IsEmbarkedTag.Seat",
      "op": "==",
      "value": 0,
      "before": 1.0
    },
    {
      "name": "the Observer's station operates the stacked binoculars",
      "on": "field",
      "who": "Binoculars",
      "path": "PossessedBy.Mode",
      "op": "==",
      "value": "Operated",
      "after": "possessed"
    },
    {
      "name": "the root turns to the marker with the look and measures it",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 447.0,
      "after": "ranged",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        }
      ]
    },
    {
      "name": "the root's laser met the marker",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastHit",
      "op": "==",
      "value": "Marker 450",
      "after": "ranged"
    },
    {
      "name": "the target reaches the stacked binoculars",
      "on": "field",
      "who": "Binoculars",
      "memory": "BinocularsState",
      "field": "HasTarget",
      "op": "==",
      "value": 1,
      "after": "sent"
    },
    {
      "name": "the stacked binoculars see the target dead ahead (0 degrees): they point as the root does, their own look ignored",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "0°"
      ],
      "after": "binoculars viewed+0.25"
    },
    {
      "name": "the cue is drawn on the stacked binoculars' HUD",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "TARGET"
      ],
      "after": "binoculars viewed+0.25"
    }
  ]
}
