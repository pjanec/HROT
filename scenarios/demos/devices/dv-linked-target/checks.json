{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-linked-target (SD-S5b). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 8,
  "golden": {
    "every": 4
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "station": 1,
        "source": "Rangefinder"
      }
    },
    {
      "name": "aimed",
      "at": 1.5,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "ranged",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    },
    {
      "name": "sent",
      "at": 4.0,
      "control": {
        "station": 1,
        "press": "SEND"
      }
    },
    {
      "name": "binoculars viewed",
      "at": 5.5,
      "view": {
        "station": 1,
        "source": "Binoculars A"
      }
    }
  ],
  "expect": [
    {
      "name": "the rangefinder measured the marker",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 447.0,
      "after": "ranged",
      "before": "sent",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        }
      ]
    },
    {
      "name": "before SEND the binoculars A hold no target",
      "on": "field",
      "who": "Binoculars A",
      "memory": "BinocularsState",
      "field": "HasTarget",
      "op": "==",
      "value": 0,
      "after": "ranged",
      "before": "sent"
    },
    {
      "name": "SEND hands the target to the linked binoculars",
      "on": "field",
      "who": "Binoculars A",
      "memory": "BinocularsState",
      "field": "HasTarget",
      "op": "==",
      "value": 1,
      "after": "sent",
      "also": [
        {
          "path": "Target.Point.X",
          "op": ">=",
          "value": -133.8
        },
        {
          "path": "Target.Point.X",
          "op": "<=",
          "value": -129.8
        },
        {
          "path": "Target.Point.Y",
          "op": ">=",
          "value": 16.2
        },
        {
          "path": "Target.Point.Y",
          "op": "<=",
          "value": 20.2
        },
        {
          "path": "Target.Range",
          "op": ">=",
          "value": 447.0
        },
        {
          "path": "Target.Range",
          "op": "<=",
          "value": 450.5
        },
        {
          "path": "Target.FromType",
          "op": "==",
          "value": 640
        }
      ]
    },
    {
      "name": "the target came from the rangefinder",
      "on": "field",
      "who": "Binoculars A",
      "memory": "BinocularsState",
      "field": "TargetFrom",
      "op": "==",
      "value": "Rangefinder",
      "after": "sent"
    },
    {
      "name": "the rangefinder counts one target sent",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Sent",
      "op": "==",
      "value": 1,
      "after": "sent"
    },
    {
      "name": "the binoculars' HUD draws the received-target cue",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "TARGET"
      ],
      "after": "binoculars viewed+0.25"
    },
    {
      "name": "the cue names its sender and the link",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "from LASER RANGEFINDER (linked)"
      ],
      "after": "binoculars viewed+0.25"
    },
    {
      "name": "the binoculars B never receive a target",
      "never": {
        "on": "field",
        "who": "Binoculars B",
        "memory": "BinocularsState",
        "field": "HasTarget",
        "op": "!=",
        "value": 0
      },
      "after": "possessed"
    }
  ]
}
