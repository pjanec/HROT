{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-vehicle-station (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 8,
  "golden": {
    "every": 4
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Commander"
      }
    },
    {
      "name": "viewed",
      "at": 1.5,
      "view": {
        "source": "Laser rangefinder"
      }
    },
    {
      "name": "aimed",
      "at": 2.0,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "ranged",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    }
  ],
  "expect": [
    {
      "name": "the rangefinder is mounted in the vehicle's device station (seat 7)",
      "on": "field",
      "who": "Laser rangefinder",
      "path": "IsEmbarkedTag.Seat",
      "op": "==",
      "value": 7,
      "before": 1.5
    },
    {
      "name": "the Commander sits in his own seat (6)",
      "on": "field",
      "who": "Commander",
      "path": "IsEmbarkedTag.Seat",
      "op": "==",
      "value": 6,
      "before": 1.5
    },
    {
      "name": "his station operates the device",
      "on": "field",
      "who": "Laser rangefinder",
      "path": "PossessedBy.Mode",
      "op": "==",
      "value": "Operated",
      "after": "possessed"
    },
    {
      "name": "the range to the marker is 450 m (within 3 m)",
      "on": "field",
      "who": "Laser rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 447.0,
      "after": "ranged",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        }
      ]
    },
    {
      "name": "the laser met the marker",
      "on": "field",
      "who": "Laser rangefinder",
      "memory": "RangefinderState",
      "field": "LastHit",
      "op": "==",
      "value": "Marker 450",
      "after": "ranged"
    },
    {
      "name": "the seat holds him to the end",
      "on": "field",
      "who": "Commander",
      "path": "IsEmbarkedTag.Seat",
      "op": "==",
      "value": 6,
      "atEnd": true
    }
  ]
}
