      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "station": 1,
        "source": "Designator"
      }
    },
    {
      "name": "aimed",
      "at": 1.5,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "powered",
      "at": 2.0,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "coded",
      "at": 3.0,
      "control": {
        "station": 1,
        "press": "CODE"
      }
    },
    {
      "name": "lased",
      "at": 4.0,
      "control": {
        "station": 1,
        "press": "LASE"
      }
    },
    {
      "name": "code while lasing",
      "at": 10.0,
      "control": {
        "station": 1,
        "press": "CODE"
      }
    },
    {
      "name": "lase while cooling",
      "at": 70.0,
      "control": {
        "station": 1,
        "press": "LASE"
      }
    },
    {
      "name": "paused",
      "at": 96.0,
      "pause": {
        "frames": 120
      }
    },
    {
      "name": "lase in pause",
      "atPausedFrame": 10,
      "control": {
        "press": "LASE"
      }
    }
  ],
  "expect": [
    {
      "name": "before POWER the designator is OFF",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Off",
      "after": "viewed",
      "before": "powered"
    },
    {
      "name": "POWER: STANDBY, the type's code 1688",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": "powered",
      "before": "coded",
      "also": [
        {
          "path": "Code",
          "op": "==",
          "value": 1688
        }
      ]
    },
    {
      "name": "CODE steps the code to the next valid one: 1711",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Code",
      "op": "==",
      "value": 1711,
      "after": "coded",
      "before": "lased"
    },
    {
      "name": "LASE: LASING",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Lasing",
      "after": "lased",
      "before": 63.5
    },
    {
      "name": "the lase meets the marker and is a live designation",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Designating",
      "op": "==",
      "value": 1,
      "after": "lased",
      "before": 63.5,
      "also": [
        {
          "path": "LastHit",
          "op": "==",
          "value": "Marker 450"
        },
        {
          "path": "LastRange",
          "op": ">=",
          "value": 447.0
        },
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        }
      ]
    },
    {
      "name": "the code never changes outside STANDBY",
      "never": {
        "on": "field",
        "who": "Designator",
        "memory": "DesignatorState",
        "field": "Code",
        "op": "!=",
        "value": 1711
      },
      "after": "lased"
    },
    {
      "name": "the lase never runs past its 60 s",
      "never": {
        "on": "field",
        "who": "Designator",
        "memory": "DesignatorState",
        "field": "Phase",
        "op": "==",
        "value": "Lasing"
      },
      "after": 64.5,
      "before": 93.5
    },
    {
      "name": "at the duty limit it COOLS",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Cooling",
      "after": 64.5,
      "before": 65.0
    },
    {
      "name": "LASE while cooling is refused: still COOLING",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Cooling",
      "after": "lase while cooling+0.5",
      "before": 93.5
    },
    {
      "name": "cooled: STANDBY again",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Standby",
      "after": 94.5,
      "before": "paused"
    },
    {
      "name": "the LASE pressed in the pause is QUEUED, the phase STANDBY (paused frame 60)",
      "atPausedFrame": 60,
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Queued",
      "op": "==",
      "value": 1,
      "also": [
        {
          "path": "Phase",
          "op": "==",
          "value": "Standby"
        }
      ]
    },
    {
      "name": "nothing is designated on any paused frame",
      "never": {
        "on": "field",
        "who": "Designator",
        "memory": "DesignatorState",
        "field": "Designating",
        "op": "!=",
        "value": 0
      },
      "after": "paused",
      "before": "paused"
    },
    {
      "name": "the queued lase starts on the first live frame (lasing at the first sample after the pause)",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Phase",
      "op": "==",
      "value": "Lasing",
      "after": 96.05,
      "before": 96.3,
      "also": [
        {
          "path": "Queued",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "name": "… and designates the marker",
      "on": "field",
      "who": "Designator",
      "memory": "DesignatorState",
      "field": "Designating",
      "op": "==",
      "value": 1,
      "after": 96.02,
      "before": 97.0
    },
    {
      "name": "the HUD shows LASING",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "LASING"
      ],
      "after": "lased+0.25",
      "before": 63.5
    },
    {
      "name": "the HUD shows COOLING",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "COOLING"
      ],
      "after": 64.5,
      "before": 93.5
    },
    {
      "name": "the HUD shows the lase queued in the pause (paused frame 60)",
      "atPausedFrame": 60,
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "queued"
      ]
    }
  ]
}
