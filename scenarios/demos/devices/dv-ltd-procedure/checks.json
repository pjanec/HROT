{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-ltd-procedure (SD-S5c). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 100,
  "golden": {
    "every": 25
