{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-drone-fly (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 40,
  "golden": {
    "every": 10
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Operator"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Drone station"
      }
    },
    {
      "name": "powered",
      "at": 1.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "armed",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "takeoff",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "TAKEOFF"
      }
    },
    {
      "name": "fly",
      "at": 7.0,
      "control": {
        "axis": {
          "3": 0.5
        },
        "for": 13.3
      }
    },
    {
      "name": "land",
      "at": 23.0,
      "control": {
        "station": 1,
        "press": "LAND"
      }
    }
  ],
  "expect": [
    {
      "name": "the drone's brain finds its station (the pairing, ControlledBy)",
      "on": "field",
      "who": "Drone",
      "memory": "RemotePilotState",
      "field": "Station",
      "op": "==",
      "value": "Drone station"
    },
    {
      "name": "the station flies that drone (its ControlledEntities slot 0)",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Drone",
      "op": "==",
      "value": "Drone"
    },
    {
      "name": "before POWER the station is OFF",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Off",
      "after": "viewed",
      "before": "powered"
    },
    {
      "name": "POWER: the drone answers - LINKED",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Linked",
      "after": "powered+0.3",
      "before": "armed"
    },
    {
      "name": "ARM: ARMED",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Armed",
      "after": "armed+0.3",
      "before": "takeoff"
    },
    {
      "name": "the sticks fly it: FLYING",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Flying",
      "after": "fly+1",
      "before": "land"
    },
    {
      "name": "LAND: it is down - LANDED",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Landed",
      "after": "land+2"
    },
    {
      "name": "it is above 8 m while it flies",
      "on": "field",
      "who": "Drone",
      "path": "SimTransform.Position.2",
      "op": ">",
      "value": 8,
      "after": "fly",
      "before": "land"
    },
    {
      "name": "it lands within 30 m of the point 200 m north",
      "on": "close",
      "who": "Drone",
      "point": [
        -296,
        -200
      ],
      "m": 30,
      "atEnd": true
    },
    {
      "name": "it is down at the end",
      "on": "field",
      "who": "Drone",
      "path": "FlightState.Airborne",
      "op": "==",
      "value": 0,
      "atEnd": true
    },
    {
      "name": "its battery drained in flight",
      "on": "field",
      "who": "Drone",
      "path": "DroneBattery.Remaining01",
      "op": "<",
      "value": 1,
      "atEnd": true
    },
    {
      "name": "the link holds while it is flown",
      "never": {
        "on": "field",
        "who": "Drone",
        "path": "DroneLink.Lost",
        "op": "==",
        "value": 1
      },
      "after": "armed",
      "before": "land"
    },
    {
      "name": "the station never becomes the drone's possessor",
      "never": {
        "on": "field",
        "who": "Drone",
        "path": "PossessedBy.Mode",
        "op": "!=",
        "value": "None"
      }
    }
  ]
}
