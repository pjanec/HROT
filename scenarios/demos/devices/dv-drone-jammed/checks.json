{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-drone-jammed (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 75,
  "golden": {
    "every": 15
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Operator"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Drone station"
      }
    },
    {
      "name": "powered",
      "at": 1.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "armed",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "ARM"
      }
    },
    {
      "name": "takeoff",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "TAKEOFF"
      }
    },
    {
      "name": "fly",
      "at": 7.0,
      "control": {
        "axis": {
          "3": 0.6
        },
        "for": 45
      }
    }
  ],
  "expect": [
    {
      "name": "the link is JAMMED in the bubble",
      "on": "field",
      "who": "Drone",
      "path": "DroneLink.Jammed",
      "op": "==",
      "value": 1,
      "after": "fly",
      "also": [
        {
          "path": "DroneLink.Lost",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "name": "the failsafe hovers",
      "on": "field",
      "who": "Drone",
      "path": "DroneLink.Phase",
      "op": "==",
      "value": "FailsafeHover",
      "after": "fly"
    },
    {
      "name": "then returns home",
      "on": "field",
      "who": "Drone",
      "path": "DroneLink.Phase",
      "op": "==",
      "value": "FailsafeReturn",
      "after": "fly"
    },
    {
      "name": "the station shows FAILSAFE",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Mode",
      "op": "==",
      "value": "Failsafe",
      "after": "fly"
    },
    {
      "name": "it never flies deeper into the bubble (the stick ignored)",
      "never": {
        "on": "field",
        "who": "Drone",
        "path": "SimTransform.Position.1",
        "op": ">",
        "value": -55
      }
    },
    {
      "name": "it is down at the end",
      "on": "field",
      "who": "Drone",
      "path": "FlightState.Airborne",
      "op": "==",
      "value": 0,
      "atEnd": true
    },
    {
      "name": "within 30 m of its launch point",
      "on": "close",
      "who": "Drone",
      "point": [
        -296,
        -400
      ],
      "m": 30,
      "atEnd": true
    },
    {
      "name": "the OSD shows LINK LOST",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "LINK LOST"
      ],
      "after": "fly"
    },
    {
      "name": "… and the reason: JAMMED",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "JAMMED"
      ],
      "after": "fly"
    }
  ]
}
