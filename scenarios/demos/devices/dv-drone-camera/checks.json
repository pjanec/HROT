{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-drone-camera (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 8,
  "golden": {
    "every": 4
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Operator"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Drone station"
      }
    },
    {
      "name": "powered",
      "at": 1.5,
      "control": {
        "station": 1,
        "press": "POWER"
      }
    },
    {
      "name": "down 1",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "CAM DOWN"
      }
    },
    {
      "name": "down 2",
      "at": 3.0,
      "control": {
        "station": 1,
        "press": "CAM DOWN"
      }
    },
    {
      "name": "up 1",
      "at": 4.5,
      "control": {
        "station": 1,
        "press": "CAM UP"
      }
    }
  ],
  "expect": [
    {
      "name": "the station films through its drone",
      "on": "field",
      "who": "Drone station",
      "path": "DeviceView.Mode",
      "op": "==",
      "value": "Eyes",
      "after": "powered+0.3"
    },
    {
      "name": "powered",
      "on": "field",
      "who": "Drone station",
      "memory": "DroneStationState",
      "field": "Power",
      "op": "==",
      "value": 1,
      "after": "powered+0.3"
    },
    {
      "name": "CAM DOWN twice: -30 degrees",
      "on": "field",
      "who": "Drone station",
      "path": "DeviceView.Pitch",
      "op": "<=",
      "value": -0.52,
      "after": "down 2+0.3",
      "before": "up 1",
      "also": [
        {
          "path": "DeviceView.Pitch",
          "op": ">=",
          "value": -0.53
        }
      ]
    },
    {
      "name": "CAM UP: -15 degrees",
      "on": "field",
      "who": "Drone station",
      "path": "DeviceView.Pitch",
      "op": "<=",
      "value": -0.26,
      "after": "up 1+0.3",
      "also": [
        {
          "path": "DeviceView.Pitch",
          "op": ">=",
          "value": -0.27
        }
      ]
    }
  ]
}
