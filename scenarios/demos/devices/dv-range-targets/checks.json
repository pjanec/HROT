{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-range-targets (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 9,
  "golden": {
    "every": 3
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer"
      }
    },
    {
      "name": "viewed",
      "at": 1.0,
      "view": {
        "source": "Rangefinder"
      }
    },
    {
      "name": "aimed at 200",
      "at": 1.5,
      "control": {
        "aim": "Marker 200"
      }
    },
    {
      "name": "ranged 200",
      "at": 2.0,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    },
    {
      "name": "aimed at 450",
      "at": 3.5,
      "control": {
        "aim": "Marker 450"
      }
    },
    {
      "name": "ranged 450",
      "at": 4.0,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    },
    {
      "name": "aimed at 900",
      "at": 5.5,
      "control": {
        "aim": "Marker 900"
      }
    },
    {
      "name": "ranged 900",
      "at": 6.0,
      "control": {
        "station": 1,
        "press": "RANGE"
      }
    }
  ],
  "expect": [
    {
      "name": "the range to Marker 200 is 200 m (within 3 m)",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 197.0,
      "after": "ranged 200",
      "before": "aimed at 450",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 200.5
        },
        {
          "path": "HasRange",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "name": "the laser met Marker 200",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastHit",
      "op": "==",
      "value": "Marker 200",
      "after": "ranged 200",
      "before": "aimed at 450"
    },
    {
      "name": "the HUD shows 200 m",
      "on": "hud",
      "source": "Rangefinder",
      "text": [
        "==",
        "200 m"
      ],
      "after": "ranged 200",
      "before": "aimed at 450"
    },
    {
      "name": "the range to Marker 450 is 450 m (within 3 m)",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 447.0,
      "after": "ranged 450",
      "before": "aimed at 900",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 450.5
        },
        {
          "path": "HasRange",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "name": "the laser met Marker 450",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastHit",
      "op": "==",
      "value": "Marker 450",
      "after": "ranged 450",
      "before": "aimed at 900"
    },
    {
      "name": "the HUD shows 450 m",
      "on": "hud",
      "source": "Rangefinder",
      "text": [
        "==",
        "450 m"
      ],
      "after": "ranged 450",
      "before": "aimed at 900"
    },
    {
      "name": "the range to Marker 900 is 900 m (within 3 m)",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastRange",
      "op": ">=",
      "value": 897.0,
      "after": "ranged 900",
      "also": [
        {
          "path": "LastRange",
          "op": "<=",
          "value": 900.5
        },
        {
          "path": "HasRange",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "name": "the laser met Marker 900",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "LastHit",
      "op": "==",
      "value": "Marker 900",
      "after": "ranged 900"
    },
    {
      "name": "the HUD shows 900 m",
      "on": "hud",
      "source": "Rangefinder",
      "text": [
        "==",
        "900 m"
      ],
      "after": "ranged 900"
    }
  ]
}
