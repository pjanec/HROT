{
  "$doc": "docs/designs/devices/DESIGN_Simulated_Devices.md §5a — dv-menu-and-modes (SD-S1). Generated by scripts/gen-devices-scenarios.py.",
  "runFor": 10,
  "golden": {
    "every": 5
  },
  "do": [
    {
      "name": "possessed",
      "at": 0.5,
      "possess": {
        "who": "Observer",
        "station": 1
      }
    },
    {
      "name": "viewed",
      "at": 1.5,
      "view": {
        "station": 1,
        "source": "Rangefinder"
      }
    },
    {
      "name": "menu 1",
      "at": 2.5,
      "control": {
        "station": 1,
        "press": "MENU"
      }
    },
    {
      "name": "menu 2",
      "at": 3.0,
      "control": {
        "station": 1,
        "press": "MENU"
      }
    },
    {
      "name": "select 1",
      "at": 3.5,
      "control": {
        "station": 1,
        "press": "SELECT"
      }
    },
    {
      "name": "mode 1",
      "at": 4.0,
      "control": {
        "station": 1,
        "press": "MODE"
      }
    },
    {
      "name": "menu 3",
      "at": 4.5,
      "control": {
        "station": 1,
        "press": "MENU"
      }
    },
    {
      "name": "select 2",
      "at": 5.5,
      "control": {
        "station": 1,
        "press": "SELECT"
      }
    }
  ],
  "expect": [
    {
      "name": "before any press the menu is closed and the mode SINGLE",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Mode",
      "op": "==",
      "value": "Single",
      "after": "viewed",
      "before": "menu 1",
      "also": [
        {
          "path": "MenuOpen",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "name": "the view shows the rangefinder's HUD in SINGLE",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "SINGLE"
      ],
      "after": "viewed",
      "before": "mode 1"
    },
    {
      "name": "MENU opens the menu on MODE",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "MenuOpen",
      "op": "==",
      "value": 1,
      "after": "menu 1",
      "before": "menu 2",
      "also": [
        {
          "path": "Menu",
          "op": "==",
          "value": "Mode"
        }
      ]
    },
    {
      "name": "the HUD shows the open menu",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "EXIT"
      ],
      "after": "menu 1",
      "before": "select 2"
    },
    {
      "name": "MENU again moves the cursor to POWER",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Menu",
      "op": "==",
      "value": "Power",
      "after": "menu 2",
      "before": "select 1"
    },
    {
      "name": "SELECT on POWER turns the power HIGH",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Power",
      "op": "==",
      "value": "High",
      "after": "select 1",
      "before": "mode 1"
    },
    {
      "name": "MODE steps the mode to CONTINUOUS",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Mode",
      "op": "==",
      "value": "Continuous",
      "after": "mode 1"
    },
    {
      "name": "the view shows CONTINUOUS",
      "on": "hud",
      "source": "station:1",
      "text": [
        "==",
        "CONTINUOUS"
      ],
      "after": "mode 1"
    },
    {
      "name": "MENU once more brings the cursor to EXIT",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "Menu",
      "op": "==",
      "value": "Exit",
      "after": "menu 3",
      "before": "select 2"
    },
    {
      "name": "SELECT on EXIT closes the menu",
      "on": "field",
      "who": "Rangefinder",
      "memory": "RangefinderState",
      "field": "MenuOpen",
      "op": "==",
      "value": 0,
      "after": "select 2",
      "also": [
        {
          "path": "Power",
          "op": "==",
          "value": "High"
        }
      ]
    },
    {
      "name": "the binoculars are at their default step",
      "on": "field",
      "who": "Binoculars",
      "memory": "BinocularsState",
      "field": "Zoom",
      "op": "==",
      "value": 1,
      "after": "viewed",
      "before": "menu 1"
    },
    {
      "name": "the binoculars never change: a press reaches only the viewed device",
      "never": {
        "on": "field",
        "who": "Binoculars",
        "memory": "BinocularsState",
        "field": "Zoom",
        "op": "!=",
        "value": 1
      },
      "after": "menu 1"
    }
  ]
}
