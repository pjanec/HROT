      "on": "field",
      "who": "Most kills",
      "path": "ObjectiveStatus.State",
      "op": "==",
      "value": "Achieved",
      "atEnd": true
    },
    {
      "name": "(S7 P-8) a standing bounty is announced to everybody",
      "on": "field",
      "who": "Bounty announced",
      "path": "ObjectiveStatus.FireCount",
      "op": ">=",
      "value": 1,
      "after": "bounty",
      "before": "bounty+3",
      "if": "bounty"
