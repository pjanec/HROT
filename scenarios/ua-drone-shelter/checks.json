{
  "$doc": "docs/DESIGN_Scenario_Regression.md §3 — Urban Armour §8 / Exposure Cycle §8: a tank hides from a drone under a garage deck, the tank in the open is hit. From the header's Judge (1)-(3), with the deck footprint x 240-290, y 40-80 read as four end-of-run bounds; the take's hide/hit anchors are proven.",
  "runFor": 40,
  "golden": {
    "every": 10
  },
  "expect": [
    {
      "name": "the deck tank takes shelter (ShelterFromAir)",
      "on": "task",
      "who": "Tank by the deck",
      "is": "ShelterFromAir"
    },
    {
      "name": "the deck tank ends under the deck (x >= 240)",
      "on": "field",
      "who": "Tank by the deck",
      "path": "SimTransform.Position.0",
      "op": ">=",
      "value": 240,
      "atEnd": true
    },
    {
      "name": "the deck tank ends under the deck (x <= 290)",
      "on": "field",
      "who": "Tank by the deck",
      "path": "SimTransform.Position.0",
      "op": "<=",
      "value": 290,
      "atEnd": true
    },
    {
      "name": "the deck tank ends under the deck (y >= 40)",
      "on": "field",
      "who": "Tank by the deck",
      "path": "SimTransform.Position.1",
      "op": ">=",
      "value": 40,
      "atEnd": true
    },
    {
      "name": "the deck tank ends under the deck (y <= 80)",
      "on": "field",
      "who": "Tank by the deck",
      "path": "SimTransform.Position.1",
      "op": "<=",
      "value": 80,
      "atEnd": true
    },
    {
      "name": "Drone A is spent",
      "on": "field",
      "who": "Drone A",
      "path": "Health.Current",
      "op": "<=",
      "value": 0
    },
    {
      "name": "the deck tank keeps 90% of its health",
      "on": "field",
      "who": "Tank by the deck",
      "path": "Health.Current",
      "op": ">=",
      "value": 2700,
      "atEnd": true
    },
    {
      "name": "the deck tank is never hit",
      "never": {
        "on": "hit",
        "target": "Tank by the deck"
      }
    },
    {
      "name": "Drone B is spent",
      "on": "field",
      "who": "Drone B",
      "path": "Health.Current",
      "op": "<=",
      "value": 0
    },
    {
      "name": "the open tank is hit from above",
      "on": "hit",
      "target": "Tank in the open"
    },
    {
      "name": "the open tank is hurt",
      "on": "field",
      "who": "Tank in the open",
      "path": "Health.Current",
      "op": "<",
      "value": 3000
    }
  ]
}
