{
  "$doc": "docs/DESIGN_Scenario_Regression.md §3 — U1: the posture decision follows the Rifleman's health (the old live check set it by hand; here 'do' does)",
  "runFor": 60,
  "golden": {"every": 10},
  "anchors": {
    "fights": {"on": "decision", "who": "Rifleman", "decision": "Combat posture", "winner": ["Suppress"]}
  },
  "do": [
    {"name": "hurt",   "at": "fights+3", "set": {"who": "Rifleman", "component": "Health", "patch": {"Current": 40}}},
    {"name": "dying",  "at": "hurt+8",   "set": {"who": "Rifleman", "component": "Health", "patch": {"Current": 10}}},
    {"name": "healed", "at": "dying+8",  "set": {"who": "Rifleman", "component": "Health", "patch": {"Current": 100}}}
  ],
  "expect": [
    {"name": "healthy and armed against a matched enemy, he suppresses", "on": "decision", "who": "Rifleman", "decision": "Combat posture", "winner": ["Suppress"], "before": 20},
    {"name": "hurt (40 HP), he defends", "on": "decision", "who": "Rifleman", "decision": "Combat posture", "winner": ["TakeCover", "Flee"], "after": "hurt", "before": "hurt+8"},
    {"name": "near death (10 HP), he defends", "on": "decision", "who": "Rifleman", "decision": "Combat posture", "winner": ["TakeCover", "Flee"], "after": "dying", "before": "dying+8"},
    {"name": "healed (100 HP), he fights again", "on": "decision", "who": "Rifleman", "decision": "Combat posture", "winner": ["Suppress", "AdvanceAndAttack"], "after": "healed", "before": "healed+12"}
  ]
}
