<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Bagira.IOS</RootNamespace>
    <AssemblyName>Bagira.IOS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bagira data model and map types -->
    <ProjectReference Include="..\Bagira.DDS.DataModel\Bagira.DDS.DataModel.csproj" />
    <ProjectReference Include="..\Bagira.Map.Common\Bagira.Map.Common.csproj" />
    <ProjectReference Include="..\Bagira.Map.Definitions\Bagira.Map.Definitions.csproj" />

    <!-- FDP Toolkits -->
    <ProjectReference Include="..\FDP\Toolkits\FDP.Toolkit.DER\FDP.Toolkit.DER.csproj" />
    <ProjectReference Include="..\FDP\Toolkits\FDP.Toolkit.Commands\FDP.Toolkit.Commands.csproj" />
    <ProjectReference Include="..\FDP\Toolkits\FDP.Toolkit.ImGui\FDP.Toolkit.ImGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Bagira.IOS.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- JSON serialisation -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- Raylib window + ImGui rendering (application shell) -->
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImGui-cs" Version="3.2.0" />
  </ItemGroup>

</Project>