<!--
  CycloneDDS configuration for test runs.
  Reduces SPDP interval so that two participants on the same machine discover
  each other within ~100 ms instead of the default ~2.5 s (LeaseDuration/4).
-->
<CycloneDDS>
  <Domain>
    <Discovery>
      <!-- Send SPDP announcements every 100 ms instead of the default ~2.5 s -->
      <SPDPInterval>100ms</SPDPInterval>
    </Discovery>
  </Domain>
</CycloneDDS>
