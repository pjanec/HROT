<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Fdp.Toolkit</RootNamespace>
  </PropertyGroup>

  <!-- InternalsVisibleTo consolidated from all absorbed projects -->
  <ItemGroup>
    <InternalsVisibleTo Include="Fdp.Toolkits.Tests" />
    <InternalsVisibleTo Include="FDP.Toolkit.Behavior.Tests" />
    <InternalsVisibleTo Include="FDP.Toolkit.Orchestration.Tests" />
    <InternalsVisibleTo Include="FDP.Toolkit.Replication.Tests" />
    <InternalsVisibleTo Include="Hrot.IG.Tests" />
    <InternalsVisibleTo Include="Fdp.Presentation.Tests" />
  </ItemGroup>

  <!-- Engine kernel -->
  <ItemGroup>
    <ProjectReference Include="..\..\Engine\Fdp.ModuleHost\Fdp.ModuleHost.csproj" />
  </ItemGroup>

  <!-- External ECS dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\..\ExtDeps\FastBTree\src\Fbt.Kernel\Fbt.Kernel.csproj" />
    <ProjectReference Include="..\..\ExtDeps\FastHSM\src\Fhsm.Kernel\Fhsm.Kernel.csproj" />
  </ItemGroup>

  <!-- FDP domain analyzer: enforces BlackboardMemoryLayout size constraints at compile time -->
  <ItemGroup>
    <ProjectReference Include="..\Fdp.Toolkits.Analyzers\Fdp.Toolkits.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- CycloneDDS (project references - no PackageReference to CycloneDDS allowed) -->
  <ItemGroup>
    <ProjectReference Include="..\..\ExtDeps\FastCycloneDds\src\CycloneDDS.Runtime\CycloneDDS.Runtime.csproj" />
    <ProjectReference Include="..\..\ExtDeps\FastCycloneDds\src\CycloneDDS.Schema\CycloneDDS.Schema.csproj" />
    <ProjectReference Include="..\..\ExtDeps\FastCycloneDds\src\CycloneDDS.Core\CycloneDDS.Core.csproj" />
  </ItemGroup>


  <!-- Runner NuGet packages -->
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.2.8" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Replication\Abstractions\" />
  </ItemGroup>


</Project>
