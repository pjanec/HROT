<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FDP.Toolkit.ImGui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core FDP dependency -->
    <ProjectReference Include="..\..\Kernel\Fdp.Core\Fdp.Core.csproj" />
    <!-- Fdp.Engine for DerEntityInspectorPanel and other engine types -->
    <ProjectReference Include="..\Fdp.Engine\Fdp.Engine.csproj" />
    <!-- Rendering abstraction -->
    <PackageReference Include="ImGui.NET" Version="1.91.0.1" /> 
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="FDP.Toolkit.ImGui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- FamFamFam Silk 16×16 icon atlas embedded so integration layers
         can load it via EmbeddedAtlasResources.GetSilkAtlasPngBytes(). -->
    <EmbeddedResource Include="..\..\Data\Icons\famfamfam-silk.png">
      <LogicalName>FDP.Toolkit.ImGui.Icons.famfamfam-silk.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
