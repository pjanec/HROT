<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hrot.IG</RootNamespace>
    <AssemblyName>Hrot.IG</AssemblyName>
  </PropertyGroup>

  <!-- Expose internals to the test project so ProcessSample can be exercised directly -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hrot.IG.Tests" />
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Integration.Tests" />
    <InternalsVisibleTo Include="Hrot.ClusterRunner.Tests" />  </ItemGroup>

  <ItemGroup>
    <!-- Hrot-specific project references -->
    <ProjectReference Include="..\Hrot.Common\Hrot.Common.csproj" />
    <ProjectReference Include="..\.\Hrot.Core\Hrot.Core.csproj" />
    <ProjectReference Include="..\Hrot.Presentation\Hrot.Presentation.csproj" />

    <!-- FDP Kernel and Toolkits -->
    <ProjectReference Include="..\FDP\Kernel\Fdp.Core\Fdp.Core.csproj" />
    <ProjectReference Include="..\FDP\Framework\Fdp.Presentation\Fdp.Presentation.csproj" />  </ItemGroup>

  <ItemGroup>
    <!-- NuGet packages -->
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
    <PackageReference Include="NLog" Version="5.2.8" />  </ItemGroup>

</Project>
