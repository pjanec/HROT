<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Hrot.Stride.Core</RootNamespace>
    <AssemblyName>Hrot.Stride.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Stride NuGet packages (4.2.1.2487) — match style used by HrotStrideApp.Game -->
  <ItemGroup>
    <PackageReference Include="Stride.Engine"    Version="4.2.1.2487" PrivateAssets="contentfiles;analyzers" />
    <PackageReference Include="Stride.Physics"   Version="4.2.1.2487" PrivateAssets="contentfiles;analyzers" />
    <PackageReference Include="Stride.Rendering" Version="4.2.1.2487" PrivateAssets="contentfiles;analyzers" />
    <PackageReference Include="Stride.Games"     Version="4.2.1.2487" PrivateAssets="contentfiles;analyzers" />
  </ItemGroup>

  <!-- DotRecast NuGet packages (pure .NET navmesh/pathfinding) -->
  <ItemGroup>
    <PackageReference Include="DotRecast.Recast"       Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour"       Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour.Crowd" Version="2026.1.3" />
  </ItemGroup>

  <!-- FDP/HROT ProjectReferences — only what is actually used in this project -->
  <ItemGroup>
    <!-- SimTransform, SimVelocity, EntityRepository -->
    <ProjectReference Include="..\..\FDP\Engine\Fdp.Core\Fdp.Core.csproj" />
    <!-- StrideRenderModelDefDto, CollisionShapeKind -->
    <ProjectReference Include="..\..\FDP\Toolkits\Fdp.Toolkits\Fdp.Toolkits.csproj" />
    <!-- DeadReckoningSyncSystem (Hrot.Common.Systems), NetworkTransform/NetworkVelocity/NetworkAuthority -->
    <ProjectReference Include="..\..\Hrot\Engine\Hrot.Core\Hrot.Core.csproj" />
  </ItemGroup>
</Project>
