<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Suppress CycloneDDS code-generator: pulled in transitively but not used here -->
    <CycloneDdsDisableCodeGen>true</CycloneDdsDisableCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit"                  Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Test target: EditorStrideSubsystem lives here -->
  <ItemGroup>
    <ProjectReference Include="..\HrotStrideApp.Game\HrotStrideApp.Game.csproj" />
  </ItemGroup>
  <!-- ST-PORT drift: the coordinator line moved CycloneDDS.NET 0.2.3 -> 0.3.2, which requires
       Microsoft.CodeAnalysis.Common >= 4.8.0, while Stride.Core.Assets.CompilerApp 4.2.1.2487 pins
       it at = 3.6.0 (NU1107). NuGet's own named resolution: reference the higher version directly.
       A build-graph pin only; the asset compiler is IncludeAssets="build". -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>


  <!-- ST-PORT (cross-lane): these suites exercise the HOSTED-REAL-EDITOR mode, which is compiled
       out on this line (see the note atop EditorStrideSubsystem.cs). They are excluded rather than
       deleted; they are the proof the mode works, and they compile again the moment the twelve
       EditorSubsystem members land and HROT_HOSTED_EDITOR is defined.
       MannequinAnimationDefIntegrationTests additionally needs
       UrbanCombatNewScenario.BuildMannequinAnimationDef, which this line does not have. -->
  <ItemGroup Condition="'$(DefineConstants.Contains(HROT_HOSTED_EDITOR))' != 'true'">
    <Compile Remove="EditorSubsystemHeadlessBootTests.cs" />
    <Compile Remove="StrideEditorUiHostTests.cs" />
    <Compile Remove="MannequinAnimationDefIntegrationTests.cs" />
  </ItemGroup>

</Project>
