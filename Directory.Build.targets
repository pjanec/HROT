<Project>
  <!--
    Fix for CycloneDDS.NET package bug: CopyReferencedIdlFiles target has no BeforeTargets/AfterTargets
    wiring, so it never runs automatically during a normal build.  We hook it in here so that IDL files
    from referenced assemblies are copied into the code-gen output directory BEFORE the code generator
    invokes idlc (which needs those includes to be present).
  -->
  <Target Name="CycloneDdsCopyReferencedIdlFilesEarly"
          BeforeTargets="CycloneDdsGenerate"
          DependsOnTargets="ResolveReferences"
          Condition="'$(CycloneDdsDisableCodeGen)' != 'true' AND '$(CycloneDdsGeneratedDir)' != ''">
    <MakeDir Directories="$(CycloneDdsGeneratedDir)" />
    <ItemGroup>
      <_CycRefDirs Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
      <_CycRefIdlFiles Include="%(_CycRefDirs.Identity)*.idl" />
    </ItemGroup>
    <Copy SourceFiles="@(_CycRefIdlFiles)"
          DestinationFolder="$(CycloneDdsGeneratedDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_CycRefIdlFiles)' != ''" />
  </Target>
</Project>
