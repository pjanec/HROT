+    // H14 (HROT road convoy): the PRIORITY TWIN of a registered vType -- the same type with SUMO's emergency-vehicle privileges: a blue
+    // light (vehicles ahead on its edge give way, Rung ER3-ER5), red lights ignored (jmDriveAfterRedTime, Rung A3) and approaching junction foes
+    // ignored (jmIgnoreFoeProb / jmIgnoreJunctionFoeProb). Registered once as "<id>@priority" and reused. Requires a loaded network.
+    public VTypeHandle PriorityTwin(VTypeHandle of)
+    {
+        if (_network is null)
+        {
+            throw new InvalidOperationException("LoadScenario/LoadNetwork must be called before PriorityTwin.");
+        }
+
+        var baseId = _vTypeIds[of.Index];
+        var twinId = baseId + "@priority";
+        var existing = _vTypeIds.IndexOf(twinId);
+        if (existing >= 0)
+        {
+            return new VTypeHandle(existing);
+        }
+
+        var raw = _vTypesById[baseId];
+        _vTypesById[twinId] = raw with
+        {
+            Id = twinId, HasBluelight = true, JmDriveAfterRedTime = 1e9, JmIgnoreFoeProb = 1.0, JmIgnoreFoeSpeed = 1e9,
+            JmIgnoreJunctionFoeProb = 1.0,
+        };
+        _vTypeIds.Add(twinId);
+        return new VTypeHandle(_vTypeIds.Count - 1);
+    }
+
