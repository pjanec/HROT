+        wallClockTicks = 0; relativeWallSeconds = 0d; simSeconds = 0d;
+        if (ActiveContext?.Playback == null || (ActiveContext?.CurrentFrame ?? -1) < 0) return;
+        var meta = ActiveContext!.Playback!.GetFrameMetadata(ActiveContext.CurrentFrame);
