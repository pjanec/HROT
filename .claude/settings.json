{
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "mcp__codebase-memory-mcp",
      "mcp__codebase-memory-mcp__*"
    ]
  },
  "defaultMode": "dangerously-skip-permissions",
  "enabledMcpjsonServers": [
    "codebase-memory-mcp"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-design-brief.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-design-brief.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-design-brief.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
