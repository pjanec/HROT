{
  "crossSessionInbound": "accept",
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__add_repo",
      "mcp__Claude_Code_Remote__register_repo_root",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__delete_trigger"
    ]
  },
  "defaultMode": "dangerously-skip-permissions",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-design-brief.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-design-brief.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "disabledMcpjsonServers": [
    "codebase-memory-mcp"
  ]
}
